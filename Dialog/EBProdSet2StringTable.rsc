		{ String _name = "EBApothecaryTip";							String _text = "La Botica produce Artículos de Salud a partir de Raíces, Hierbas, Vino, Aceite de Semillas, Agua y Cristalería. Se pueden emplear hasta 2 Boticarios para producir de 3 a 4 Caldo Curativo, Aceite Curativo o Té de Hierbas. Ciclo de Construcción: 60."; }
		
		{ String _name = "EBHerbalist";								String _text = "Herbolario"; }
