		{ String _name = "EBHerbalistTip";							String _text = "El Herbolario se utiliza para recolectar hierbas y proporcionar salud y curación básica a los ciudadanos. Se pueden emplear hasta 2 Herbolarios para recolectar de 2 a 3 Hierbas. Ciclo de Construcción: 42."; }
		
		{ String _name = "EBGlassWorks";							String _text = "Vidriería";	}
