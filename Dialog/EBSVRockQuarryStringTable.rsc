		{ String _name = "EBSVRockQuarry";								String _text = "Cantera de Roca del Pueblo";	}
		{ String _name = "EBSVRockQuarryLwr";							String _text = "cantera de roca del pueblo";	}
		{ String _name = "EBSVRockQuarryTip";							String _text = "La Cantera de Roca del Pueblo se usa para extraer Piedra. Se pueden emplear hasta 12 Canteros para producir de 1 a 2 piedras. Trabajo: 10/10.0. Capacidad: 6000. Ciclos de Construcción: 60. La Cantera puede transformarse en una Zona de Descanso o una Piscifactoría.";  }
		
		{ String _name = "SVRockQuarryResortUpgradeTip";				String _text = "Transforma la Cantera en una Zona de Descanso."; }
		{ String _name = "SVRockQuarryFishUpgradeTip";					String _text = "Transforma la Cantera en una Piscifactoría."; }
		
		{ String _name = "EBSVRockQuarryResort";						String _text = "Zona de Descanso del Pueblo";	}
		{ String _name = "EBSVRockQuarryResortLwr";						String _text = "zona de descanso del pueblo";	}
		{ String _name = "EBSVRockQuarryResortTip";						String _text = "La Cantera del Pueblo se transforma en una Zona de Descanso con Mercado de Comida. Se pueden emplear hasta 2 Vendedores. Proporciona Felicidad por Entretenimiento. Ciclos de Construcción: 32.";  }
		
		{ String _name = "EBSVRockQuarryFish";							String _text = "Piscifactoría del Pueblo";	}
		{ String _name = "EBSVRockQuarryFishLwr";						String _text = "piscifactoría del pueblo";	}
		{ String _name = "EBSVRockQuarryFishTip";						String _text = "La Cantera del Pueblo se transforma en una Piscifactoría. Se pueden emplear hasta 4 pescadores para capturar de 5 a 7 peces. Trabajo: 4/6.0. Ciclos de Construcción: 32.";  }
