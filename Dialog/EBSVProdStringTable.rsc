{
	Entry _strings
	[	
		//buildings
		{ String _name = "EBSVTannery";									String _text = "Curtiduría del Pueblo";	}
		{ String _name = "EBSVTanneryLwr";								String _text = "curtiduría del pueblo";	}
		{ String _name = "EBSVTanneryTip";								String _text = "La Curtiduría del Pueblo produce Cuero Curtido. Se puede emplear a 1 Curtidor para producir 1 Cuero Curtido a partir de 1 Cuero, 1 Agua y 3 Sal. Ciclos de Construcción: 50. 2 Variaciones de Color con Tecla F.";  }
		
		{ String _name = "EBSVSaltMine";								String _text = "Mina de Sal del Pueblo";	}
		{ String _name = "EBSVSaltMineLwr";								String _text = "mina de sal del pueblo";	}
		{ String _name = "EBSVSaltMineTip";								String _text = "La Mina de Sal del Pueblo extrae Sal de un yacimiento de sal. Se pueden emplear hasta 2 Trabajadores para extraer y procesar la Sal. Produce: 8 a 12 de Sal. Ciclos de Construcción: 52. 2 Variaciones de Color con Tecla F."; }
		
		{ String _name = "EBSVWaterWell";								String _text = "Pozo de Agua del Pueblo";	}
		{ String _name = "EBSVWaterWellLwr";							String _text = "pozo de agua del pueblo";	}
		{ String _name = "EBSVWaterWellTip";							String _text = "El Pozo de Agua del Pueblo contiene agua. Se puede emplear a 1 Trabajador para recolectar 12 a 16 de Agua del Pozo. Ciclos de Construcción: 42. 2 Variaciones de Color con Tecla F."; }
		
		{ String _name = "EBSVShoemaker";								String _text = "Zapatería del Pueblo";	}
		{ String _name = "EBSVShoemakerLwr";							String _text = "zapatería del pueblo";	}
		{ String _name = "EBSVShoemakerTip";							String _text = "La Zapatería del Pueblo produce Zapatos. Se puede emplear a 1 Zapatero para producir varios tipos de calzado a partir de Cuero, Aceite de Linaza y Cuero Curtido. Ciclos de Construcción: 50. 2 Variaciones de Color con Tecla F.";  }
		
		{ String _name = "EBSVOilPress";								String _text = "Prensa de Aceite del Pueblo";	}
		{ String _name = "EBSVOilPressLwr";								String _text = "prensa de aceite del pueblo";	}
		{ String _name = "EBSVOilPressTip";								String _text = "La Prensa de Aceite del Pueblo produce 14 a 18 de Aceite Vegetal a partir de 25 Granos y 1 Ánfora, 14 a 18 de Aceite de Semillas a partir de 25 de Pacana o 25 de Nuez y 1 Ánfora, o 14 a 18 de Aceite de Linaza a partir de 25 de Lino y 1 Ánfora. Se pueden emplear hasta 2 Prensadores para producir 18 a 24 de Aceite de Semillas a partir de Pacana o Nuez, producir 18 a 24 de Aceite Vegetal a partir de 50 Granos, o producir 18 a 24 de Aceite de Linaza a partir de 50 de Lino. Ciclos de Construcción: 48. 2 Variaciones de Color con Tecla F."; }
		
		{ String _name = "EBSVSandPit";									String _text = "Cantera de Arena del Pueblo"; }
		{ String _name = "EBSVSandPitLwr";								String _text = "cantera de arena del pueblo"; }
		{ String _name = "EBSVSandPitTip";								String _text = "La Cantera de Arena del Pueblo produce Arena. Se pueden emplear hasta 3 Trabajadores para producir 5 a 7 de Arena. Ciclos de Construcción: 36. 2 Variaciones de Color con Tecla F."; }
		
		{ String _name = "EBSVPottery";									String _text = "Alfarería del Pueblo";	}
		{ String _name = "EBSVPotteryLwr";								String _text = "alfarería del pueblo";	}
		{ String _name = "EBSVPotteryTip";								String _text = "La Alfarería del Pueblo produce Ánforas. Se puede emplear a 1 Alfarero para producir 3 a 4 Ánforas a partir de 4 de Arcilla y 1 de Carbón Mineral o 1 de Carbón Vegetal. Ciclos de Construcción: 50. 2 Variaciones de Color con Tecla F.";  }
		
		{ String _name = "EBSVKiln";									String _text = "Horno del Pueblo";	}
		{ String _name = "EBSVKilnLwr";									String _text = "horno del pueblo";	}
		{ String _name = "EBSVKilnTip";									String _text = "El Horno del Pueblo produce Ladrillos. Se puede emplear a 1 Trabajador para producir Ladrillos a partir de Arcilla y Combustible. Ciclos de Construcción: 50. 2 Variaciones de Color con Tecla F.";  }
		
		{ String _name = "EBSVClayPit";									String _text = "Cantera de Arcilla del Pueblo"; }
		{ String _name = "EBSVClayPitLwr";								String _text = "cantera de arcilla del pueblo"; }
		{ String _name = "EBSVClayPitTip";								String _text = "La Cantera de Arcilla del Pueblo produce Arcilla. Se pueden emplear hasta 3 Trabajadores para producir 5 a 7 de Arcilla. Ciclos de Construcción: 36. 2 Variaciones de Color con Tecla F."; }
		
		{ String _name = "EBSVApiary";									String _text = "Apiario del Pueblo"; }
		{ String _name = "EBSVApiaryLwr";								String _text = "apiario del pueblo"; }
		{ String _name = "EBSVApiaryTip";								String _text = "El Apiario del Pueblo se usa para mantener abejas y generar miel. Se pueden emplear hasta 2 Apicultores para producir 16 a 22 de Miel. Ciclos de Construcción: 46. 2 Variaciones de Color con Tecla F."; }
		
		{ String _name = "EBSVPreservist";								String _text = "Conservería del Pueblo"; }
		{ String _name = "EBSVPreservistLwr";							String _text = "conservería del pueblo"; }
		{ String _name = "EBSVPreservistTip";							String _text = "La Conservería del Pueblo produce Carne en Conserva o Fruta en Conserva. Se pueden emplear hasta 2 Conserveros para producir 12 a 14 de Carne en Conserva a partir de 7 de Venado, Cordero, Res o Pollo, 2 de Sal y 1 Ánfora, o 10 a 14 de Fruta en Conserva a partir de 7 de Ciruelas, Peras o Duraznos, 2 de Miel y 1 Ánfora. Ciclos de Construcción: 52. 2 Variaciones de Color con Tecla F."; }
		
