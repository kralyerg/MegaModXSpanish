		{
			String _name = "column2text07";
			String _text = "Coque";
		}
		{
			String _name = "Coke00Tip";
			String _text = "El Coque, una forma 'cocida' del carbón, se produce bajo el límite de Combustibles: Metalúrgicos para controlar la producción.";
		}
		{
			String _name = "column2text08";
			String _text = "21 Carbón";
		}
		{
			String _name = "Coke01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 63. Un trabajador no educado dará una ganancia de 105, o 5 por unidad de Coque; mientras tanto, un trabajador educado obtendrá una ganancia total de 209, o 6.15 por unidad de Coque.";
		}
		{
			String _name = "CokeQty";
