StringTable Info
{
	Entry _strings
	[
		{
			String _name = "HealthHappiness";
			String _text = "Salud y Felicidad";
		}
		{
			String _name = "HealthHappinessTitle1";
			String _text = "Salud y Felicidad";
		}
		{
			String _name = "HealthHappinessTitle2";
			String _text = "- sobre las enfermedades y dolencias que afectan a los aldeanos, y sobre su felicidad y depresión -";
		}
		{
			String _name = "column1text01";
			String _text = "La Salud y la Felicidad en Banished se muestran al jugador mediante el uso de iconos (véase a la derecha), ya sea como una estadística promedio del pueblo, o de forma individual al seleccionar y ver la interfaz de un ciudadano.";
		}
		{
			String _name = "column1text02";
			String _text = "Al jugar a Banished, a veces puede ser fácil tener un pueblo con los corazones o las estrellas al máximo (para los niveles de Salud o Felicidad, respectivamente).";
		}
		{
			String _name = "column1text03";
			String _text = "Pero al usar los mods DS*, los ciudadanos se verán influenciados con más frecuencia y en mayor medida por lo que los hace enfermar o ser infelices. Esto le da al jugador una experiencia de juego más desafiante e interactiva.";
		}
		{
			String _name = "column1text04";
			String _text = "*(esto solo tendrá efecto cuando ciertos mods DS se coloquen por encima de otros mods que también puedan alterar el archivo de ciudadanos).";
		}
		{
			String _name = "column1text05";
			String _text = "Ahora resulta necesario garantizar que se suministre a los ciudadanos una nutrición, unas necesidades espirituales y otras necesidades adecuadas, además de dar mayor importancia a la planificación urbana para combatir los factores que reducen la felicidad.";
		}
		{
			String _name = "column1text06";
			String _text = "Enfermedades y Dolencias";
		}
		{
			String _name = "column1text07";
			String _text = "Junto con los cambios en la salud y la felicidad de los ciudadanos, hay cambios";
		}
		{
			String _name = "column1text07add";
			String _text = "en la probabilidad y los tipos de enfermedades que los ciudadanos pueden contraer. Cuando un ciudadano sufre alguna de ellas, necesitará la atención de un Hospital y un Médico.";
		}
		{
			String _name = "column1text08";
			String _text = "una lista de las enfermedades y dolencias:";
		}
		{
			String _name = "column1text09";
			String _text = "Apoplejía (derrame cerebral)";
		}
		{
			String _name = "column1text10";
			String _text = "Atrofia (desgaste muscular)";
		}
		{
			String _name = "column1text11";
			String _text = "Biliosidad";
		}
		{
			String _name = "column1text12";
			String _text = "Fiebre negra (parasitaria)";
		}
		{
			String _name = "column1text13";
			String _text = "Septicemia (sepsis)";
		}
		{
			String _name = "column1text14";
			String _text = "Hueso roto";
		}
		{
			String _name = "column1text15";
			String _text = "Varicela";
		}
		{
			String _name = "column1text16";
			String _text = "Cólera";
		}
		{
			String _name = "column1text17";
			String _text = "Diarrea";
		}
		{
			String _name = "column1text18";
			String _text = "Difteria";
		}
		{
			String _name = "column1text19";
			String _text = "Disentería (el flujo sanguinolento)";
		}
		{
			String _name = "column1text20";
			String _text = "Endocarditis (enfermedad del elfo del agua)";
		}
		{
			String _name = "column1text21";
			String _text = "Ergotismo (fuego de san antonio)";
		}
		{
			String _name = "column1text22";
			String _text = "Gonorrea";
		}
		{
			String _name = "column1text23";
			String _text = "Gripe (sudor inglés)";
		}
		{
			String _name = "column1text24";
			String _text = "Lepra";
		}
		{
			String _name = "column1text25";
			String _text = "Malaria (la fiebre terciana)";
		}
		{
			String _name = "column1text26";
			String _text = "Sarampión";
		}
		{
			String _name = "column1text27";
			String _text = "Paperas";
		}
		{
			String _name = "column1text28";
			String _text = "Peste (la muerte negra)";
		}
		{
			String _name = "column1text29";
			String _text = "Neumonía";
		}
		{
			String _name = "column1text30";
			String _text = "Escarlatina";
		}
		{
			String _name = "column1text31";
			String _text = "Escrófula (el mal del rey)";
		}
		{
			String _name = "column1text32";
			String _text = "Escorbuto";
		}
		{
			String _name = "column1text33";
			String _text = "Viruela (la plaga roja)";
		}
		{
			String _name = "column1text34";
			String _text = "Tuberculosis";
		}
		{
			String _name = "column1text35";
			String _text = "Fiebre tifoidea (tifus)";
		}
		{
			String _name = "column1text36";
			String _text = "Tos Ferina";
		}
		{
			String _name = "column1text37";
			String _text = "Fiebre Amarilla";
		}
		{
			String _name = "column1labelDeathLow";
			String _text = "probabilidad de muerte: improbable";
		}
		{
			String _name = "column1labelDeathMed";
			String _text = "probabilidad de muerte: posible";
		}
		{
			String _name = "column1labelDeathHigh";
			String _text = "probabilidad de muerte: común";
		}
		{
			String _name = "column1labelAcqVeryLow";
			String _text = "probabilidad de contraerla: muy baja";
		}
		{
			String _name = "column1labelAcqLow";
			String _text = "probabilidad de contraerla: baja";
		}
		{
			String _name = "column1labelAcqAvg";
			String _text = "probabilidad de contraerla: ocasional";
		}
		{
			String _name = "column1labelAcqAbAvg";
			String _text = "probabilidad de contraerla: común";
		}
		{
			String _name = "column1labelAcqHigh";
			String _text = "probabilidad de contraerla: alta";
		}
		{
			String _name = "column1labelAcqVeryHigh";
			String _text = "probabilidad de contraerla: muy alta";
		}
		{
			String _name = "column1labelTransNo";
			String _text = "¿se puede transmitir? no";
		}
		{
			String _name = "column1labelTransYes";
			String _text = "¿se puede transmitir? sí";
		}
		{
			String _name = "column2text01";
			String _text = "Iconos de salud:";
		}
		{
			String _name = "column2text02";
			String _text = "La salud de un ciudadano está determinada por muchos factores:";
		}
		{
			String _name = "column2text03";
			String _text = "Tener una dieta completa formada por muchos alimentos de todas las categorías: Frutas, Cereales, Proteínas y Verduras.";
		}
		{
			String _name = "column2text04";
			String _text = "Herbolarios con amplias existencias de Hierbas y medicinas.";
		}
		{
			String _name = "column2text05";
			String _text = "Médicos y una capacidad adecuada de atención a pacientes para la rápida prevención de enfermedades.";
		}
		{
			String _name = "column2text06";
			String _text = "Los barcos de comercio y los nómadas conllevan un alto riesgo de traer enfermedades a los pueblos. Esto puede reducir drásticamente la salud de los ciudadanos si no existen controles preventivos.";
		}
		{
			String _name = "column2text07";
			String _text = "Asimismo, la falta de Herbolarios que las administren, o un suministro inadecuado de Hierbas y Medicinas, hará que las enfermedades comunes sean muy frecuentes entre los aldeanos. Esto se vuelve preocupante con ciudadanos muy poco saludables, que son propensos a albergar y transmitir enfermedades mortales.";
		}
		{
			String _name = "column2text08";
			String _text = "Es sumamente importante mantener a tus ciudadanos abrigados a medida que bajan las temperaturas. Esto implica no solo un suministro constante de combustible para el hogar, sino también caminos y carreteras adecuados para que los ciudadanos lleguen rápidamente a lugares cálidos.";
		}
		{
			String _name = "column2text09";
			String _text = "Los edificios que ofrecen salud a los ciudadanos se distinguen por los colores de su radio:";
		}
		{
			String _name = "column2text10";
			String _text = "Los herbolarios son conocidos por recolectar, preparar y administrar hierbas medicinales para las numerosas dolencias menores que sufren los ciudadanos a lo largo de sus vidas.";
		}
		{
			String _name = "column2text11";
			String _text = "Los Hospitales y los Médicos son necesarios para el tratamiento de enfermedades de naturaleza infecciosa y mortal, así como de dolencias complicadas como los huesos rotos (véase la lista a la izquierda).";
		}
		{
			String _name = "column3text01";
			String _text = "Iconos de felicidad:";
		}
		{
			String _name = "column3text02";
			String _text = "La Felicidad de un ciudadano se divide en las siguientes categorías positivas otorgadas por los edificios, fácilmente distinguibles por los colores de su radio correspondiente:";
		}
		{
			String _name = "column3text03";
			String _text = "Seguridad";
		}
		{
			String _name = "column3text04";
			String _text = "Bienes";
		}
		{
			String _name = "column3text05";
			String _text = "Espíritu";
		}
		{
			String _name = "column3text06";
			String _text = "Entretenimiento";
		}
		{
			String _name = "column3text07";
			String _text = "Alcohol";
		}
		{
			String _name = "column3text08";
			String _text = "Otros";
		}
		{
			String _name = "column3text09";
			String _text = "Además de esto, también existe a veces un aspecto negativo generado por edificios ruidosos, malolientes o peligrosos:";
		}
		{
			String _name = "column3text10";
			String _text = "Detracción";
		}
		{
			String _name = "column3text11";
			String _text = "La depresión se vuelve muy real para los ciudadanos infelices, que se quedarán ociosos con más frecuencia y serán menos productivos.";
		}
		{
			String _name = "column3text12";
			String _text = "Y como en una espiral descendente: cuanto menos trabajo realizan, más infelices se vuelven.";
		}
		{
			String _name = "column3text13";
			String _text = "Hacer que tus ciudadanos se sientan seguros mediante pozos contra incendios, o incluso torres de vigilancia y murallas.";
		}
		{
			String _name = "column3text14";
			String _text = "Los Mercados, Mercaderes y Puestos de Comercio, junto con algunos edificios de producción, pueden aportar felicidad de Bienes a los ciudadanos.";
		}
		{
			String _name = "column3text15";
			String _text = "Garantizar que sus necesidades Espirituales se satisfagan mediante Capillas y lugares de culto y oración, pero también mediante cementerios y lugares donde los ciudadanos puedan llorar a sus seres perdidos.";
		}
		{
			String _name = "column3text16";
			String _text = "La felicidad de Entretenimiento se divide en dos categorías, definidas por los colores de su radio:";
		}
		{
			String _name = "column3text17";
			String _text = "Alcohol, Posadas y Tabernas. A los ciudadanos les gusta consumir alcohol y la vida de taberna. Mantén las bodegas y las tabernas llenas.";
		}
		{
			String _name = "column3text18";
			String _text = "La felicidad de Otro Entretenimiento puede provenir de teatros, monumentos u otros edificios no relacionados con el alcohol.";
		}
		{
			String _name = "column3text19";
			String _text = "El radio de los edificios con Detracción influirá negativamente en cualquier ciudadano que se encuentre dentro de él. Mediante la planificación urbana y la construcción de factores positivos alrededor de estos edificios de producción, puedes asegurarte de que los trabajadores no se vuelvan excesivamente infelices.";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoHouseholdFuels
{
	Entry _strings
	[
		{
			String _name = "HouseholdFuels";
			String _text = "Combustibles Domésticos";
		}
		{
			String _name = "HouseholdFuelsTitle1";
			String _text = "Combustibles Domésticos";
		}
		{
			String _name = "HouseholdFuelsTitle2";
			String _text = "- sobre los combustibles que los ciudadanos usarán para calentar sus hogares -";
		}
		{
			String _name = "column1text01a";
			String _text = "Calentar el hogar es tan importante como el techo y las paredes que retienen el calor. El hogar de una casa es lo que la convierte en un verdadero hogar; es donde los ciudadanos se mantendrán calientes y cocinarán sus comidas.";
		}
		{
			String _name = "column1text01b";
			String _text = "Dependiendo de la vivienda, su necesidad de combustible solo se da por debajo de cierta temperatura. Por ejemplo, las casas de madera y piedra estándar requerirán combustible para mantener calientes a los ciudadanos a 50 grados F y por debajo (esto representa la calidad del aislamiento de las casas, capaces de soportar temperaturas más bajas).";
		}
		{
			String _name = "column1text01c";
			String _text = "La variación en la calidez de las viviendas estándar proviene de la cantidad de calor y tiempo disponibles a partir de un combustible doméstico (lo eficiente que sea el hogar/fuego). Una casa de madera tendrá una calificación de calidez de 60, mientras que la casa de piedra tendrá una calificación de calidez de 90, logrando así más calor con menos combustible.";
		}
		{
			String _name = "valueTip";
			String _text = "Valor del producto";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valor del producto; este producto tiene un valor fluctuante, por lo que los comerciantes pueden ofrecer o comprar a un precio dentro de este rango";
		}
		{
			String _name = "weightTip";
			String _text = "Peso del producto";
		}
		{
			String _name = "quantityTip";
			String _text = "Cantidad de producto producida por trabajadores educados o no educados";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "se fabrica a partir de:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "o:";
		}
		{
			String _name = "Firewood00";
			String _text = "Leña";
		}
		{
			String _name = "Firewood00Tip";
			String _text = "La Leña se produce y almacena bajo el límite de Combustible: Doméstico. Se obtienen 6 unidades a partir de un Tronco, tanto por leñadores no educados como educados.";
		}
		{
			String _name = "Firewood01";
			String _text = "1 Tronco";
		}
		{
			String _name = "Firewood01Tip";
			String _text = "Hay un costo de insumos por ciclo de 5 por el único tronco. Tanto los trabajadores no educados como los educados obtendrán una ganancia total de 7, o 1.17 por unidad de Leña.";
		}
		{
			String _name = "Firewood02";
			String _text = "2 Madera";
		}
		{
			String _name = "Firewood02Tip";
			String _text = "Hay un costo de insumos por ciclo de 8 por la madera. Tanto los trabajadores no educados como los educados obtendrán una ganancia total de 4, o 0.67 por unidad de Leña.";
		}
		{
			String _name = "FirewoodQty";
			String _text = "Producción: 6";
		}
		{
			String _name = "FirewoodValue";
			String _text = "2";
		}
		{
			String _name = "FirewoodWeight";
			String _text = "2";
		}
		{
			String _name = "column2text09";
			String _text = "Carbón Vegetal";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "El Carbón Vegetal, creado mediante una reacción térmica llamada pirólisis, se produce bajo el límite de Combustibles: Metalúrgicos para controlar la producción. El Carbón Vegetal también es un combustible que los ciudadanos usarán para calentar sus hogares si lo tienen disponible cerca.";
		}
		{
			String _name = "column2text10";
			String _text = "21 Troncos";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 105. Un trabajador no educado dará una ganancia de 133, o 3.91 por unidad de Carbón Vegetal; mientras tanto, un trabajador educado obtendrá una ganancia total de 280, o 5.09 por unidad de Carbón Vegetal.";
		}
		{
			String _name = "CharcoalQty";
			String _text = "Producción: 34-55";
		}
		{
			String _name = "CharcoalValue";
			String _text = "7";
		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

