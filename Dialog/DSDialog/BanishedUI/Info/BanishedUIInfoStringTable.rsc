		}
		{
			String _name = "column2text09";
			String _text = "Carbón Vegetal";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "El Carbón Vegetal, creado mediante una reacción térmica llamada pirólisis, se produce bajo el límite de Combustibles: Metalúrgicos para controlar la producción. El Carbón Vegetal también es un combustible que los ciudadanos usarán para calentar sus hogares si lo tienen disponible cerca.";
		}
