		{
			String _name = "column2text13";
			String _text = "1 Coque o Carbón Vegetal";
		}
		{
			String _name = "Lime01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 19-20 (Carbón Vegetal-Coque). Un trabajador no educado dará una ganancia de 5-6 (Coque-Carbón Vegetal), o 1-1.2 por porción de Cal; mientras tanto, un trabajador educado obtendrá una ganancia total de 20-21, o 2.5-2.63 por porción de Cal.";
		}
		{
			String _name = "column2text14";
			String _text = "1 Piedra + ";
		}
		{
			String _name = "column2text15";
			String _text = "5 Carbón o Leña";
		}
		{
			String _name = "Lime02Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 22-27 (Leña-Carbón). Un trabajador no educado dará una ganancia de 3 con Leña y una pérdida de 2 con Carbón; mientras tanto, un trabajador educado obtendrá una ganancia total de 13-18 (Carbón-Leña), o 1.63-2.25 por porción de Cal.";
		}
		{
			String _name = "LimeQty";
			String _text = "Producción: 5-8";
		}
		{
			String _name = "LimeValue";
			String _text = "5";
		}
		{
			String _name = "LimeWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoPotteryGlass
{
	Entry _strings
	[
		{
			String _name = "PotteryGlass";
			String _text = "Cerámica y Vidrio";
		}
		{
			String _name = "PotteryGlassTitle1";
			String _text = "Cerámica, Ladrillos, Tejas y Fabricación de Vidrio";
		}
		{
			String _name = "PotteryGlassTitle2";
			String _text = "- sobre las materias primas de la tierra, como vasijas y vidrio de corona -";
		}
		{
			String _name = "column1text01";
			String _text = "La Cerámica es un importante bien fabricado y utensilio, usado en la vida cotidiana por los ciudadanos. Como muchos objetos diferentes: una simple lámpara, se usa como elemento esencial de construcción (en particular en minas), y como vasijas para mezclar, almacenar y conservar artículos.";
		}
		{
			String _name = "column1text02";
			String _text = "No se puede negar la importancia del uso de Ladrillos y Tejas en la construcción de edificios. En la mayoría de los casos son más ligeros y duraderos que sus equivalentes de piedra, madera y paja. Y cuando se usan en la construcción de viviendas, aumentarán y proporcionarán una mejor retención de la calidez y el calor.";
		}
		{
			String _name = "column1text03";
			String _text = "El Vidrio es una creación maravillosa; el vidrio de corona, del tipo usado para las ventanas de los edificios, tiene muchos beneficios: al dejar entrar más luz, permite que los hogares usen menos combustible, ya que ya no vivimos en chozas de piedra oscuras y húmedas. Útil en los edificios de producción, más luz permite que el trabajo se realice más rápido y con mejor calidad.";
		}
		{
			String _name = "column1text04";
			String _text = "La Cristalería, al igual que la cerámica, se fabrica y usa como vasijas para mezclar y almacenar artículos; también la usa una Refinería para producir Amuletos.";
		}
		{
			String _name = "column1text05";
			String _text = "Mostrando aún más los increíbles usos de este material: la Cal, que también se puede usar en la producción de cerámica y vidrio. En la producción de Cerámica, junto con la Arena, sustituye a la arcilla en la receta. En la producción de vidrio, actúa de forma muy similar al ser un aglutinante para un vidrio más resistente, pero también permite usar menos Arena.";
		}
		{
			String _name = "column2AreMadeFrom";
			String _text = "se fabrican a partir de:";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "se fabrica a partir de:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "o:";
		}
		{
			String _name = "valueTip";
			String _text = "Valor del producto";
		}
		{
			String _name = "valueTolTip";
			String _text = "Valor del producto; este producto tiene un valor fluctuante, por lo que los comerciantes pueden ofrecer o comprar a un precio dentro de este rango";
		}
		{
			String _name = "weightTip";
			String _text = "Peso del producto";
		}
		{
			String _name = "quantityTip";
			String _text = "Cantidad de producto producida por trabajadores educados o no educados";
		}
		{
			String _name = "column2text01";
			String _text = "Cerámica";
		}
		{
			String _name = "Pottery00Tip";
			String _text = "Un bien fabricado ampliamente usado, la Cerámica ofrece muchas funciones a los ciudadanos en la producción y la construcción. Usa el límite de Bienes Fabricados y Utensilios para controlar la producción.";
		}
		{
			String _name = "column2text02";
			String _text = "4 Arcilla + ";
		}
		{
			String _name = "column2text03";
			String _text = "1 Coque o Carbón Vegetal";
		}
		{
			String _name = "Pottery01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 19-20 (Carbón Vegetal-Coque). Un trabajador no educado obtendrá una ganancia total de 4-5 (Coque-Carbón Vegetal), ya que solo se fabrican 3 unidades de Cerámica; mientras tanto, un trabajador educado fabricará 4 unidades de Cerámica con una ganancia total de 12-13, o 3-3.25 por unidad de Cerámica.";
