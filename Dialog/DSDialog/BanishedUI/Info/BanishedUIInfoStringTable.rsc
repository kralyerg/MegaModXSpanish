			String _text = "25";
		}
		{
			String _name = "column2text16";
			String _text = "Plata";
		}
		{
			String _name = "Silver00Tip";
			String _text = "La maravillosa Plata, usada comúnmente como moneda, al ser un artículo de alto valor y bajo peso, se produce bajo su propio límite para controlar la producción/acumulación.";
		}
		{
			String _name = "column2text17";
			String _text = "2 Mineral de Plata + ";
		}
		{
			String _name = "column2text18";
			String _text = "1 Coque o Carbón Vegetal";
		}
		{
			String _name = "Silver01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 23-24 (Carbón Vegetal-Coque). Un trabajador no educado tendrá una pérdida de 2-3, ya que solo se fabrica 1 unidad de Plata; mientras tanto, un trabajador educado obtendrá una ganancia total de 18-19 (Coque-Carbón Vegetal), o 9-9.5 por unidad de Plata.";
		}
		{
			String _name = "SilverQty";
			String _text = "Producción: 1-2";
		}
		{
			String _name = "SilverValue";
			String _text = "21";
		}
		{
			String _name = "SilverWeight";
			String _text = "21";
		}
		{
			String _name = "column2text19";
			String _text = "Lingote de Plata";
		}
		{
			String _name = "SilverIngot00Tip";
			String _text = "Un artesano hábil es capaz de forjar con éxito un Lingote de Plata, usando menos combustible para una mayor masa de plata, de mayor valor como moneda; se produce bajo el límite de Plata para controlar la producción/acumulación.";
		}
		{
			String _name = "column2text20";
			String _text = "6 Mineral de Plata + ";
		}
		{
			String _name = "column2text21";
			String _text = "1 Coque o Carbón Vegetal";
		}
		{
			String _name = "SilverIngot01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 55-56 (Carbón Vegetal-Coque). Un trabajador no educado dará una pérdida de 5-6, ya que no podrá mantener el calor del horno con una cantidad tan pequeña de combustible, y solo producirá 1 Lingote de Plata; mientras tanto, un trabajador educado y hábil obtendrá una ganancia total de 44-45 (Coque-Carbón Vegetal), o 22-22.5 por Lingote de Plata.";
		}
		{
			String _name = "SilverIngotQty";
			String _text = "Producción: 1-2";
		}
		{
			String _name = "SilverIngotValue";
			String _text = "50";
		}
		{
			String _name = "SilverIngotWeight";
			String _text = "50";
		}
		{
			String _name = "GoldTitle";
			String _text = "Oro";
		}
		{
			String _name = "Gold00Tip";
			String _text = "El Oro, aunque no se extrae de forma deliberada ni se encuentra en cantidades suficientes para ello, se halla en su forma nativa pura y a veces se extrae en minas de plata o se obtiene cribando a lo largo de ríos y arroyos. Usado como moneda, el Oro también tiene su propio límite para controlar la producción/acumulación.";
		}
		{
			String _name = "GoldQty";
			String _text = "Producción: 1";
		}
		{
			String _name = "Gold01Tip";
			String _text = "El Oro es un metal raro y valioso; la probabilidad de encontrarlo es baja, con una posibilidad de 1:21.";
		}
		{
