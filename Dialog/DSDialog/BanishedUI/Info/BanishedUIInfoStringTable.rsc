			String _text = "25";
		}
		{
			String _name = "column2text01cBronze";
			String _text = "Bronce";
		}
		{
			String _name = "Bronze00Tip";
			String _text = "El Bronce se produce bajo el límite de Metales, Aleaciones y Forjados para controlar la producción. Se usa en herramientas y en la construcción de edificios.";
		}
		{
			String _name = "column2text02cBronze";
			String _text = "7 Mineral de Cobre + ";
		}
		{
			String _name = "Bronze01Tip";
			String _text = "Este método tiene un costo de insumos por ciclo de 47-49 (Carbón Vegetal-Coque). Un trabajador no educado obtendrá una ganancia de 11-13, ya que solo se fabrica 1 unidad de Bronce; mientras tanto, un trabajador educado obtendrá una ganancia total de 41-43 (Coque-Carbón Vegetal), o 13.67-14.33 por unidad de Bronce.";
		}
		{
			String _name = "column2text04cBronze";
			String _text = "1 Mineral de Estaño + ";
		}
		{
			String _name = "BronzeQty";
