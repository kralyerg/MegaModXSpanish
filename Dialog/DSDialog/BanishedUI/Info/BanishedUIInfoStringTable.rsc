		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "column2text11";
			String _text = "Cal";
		}
		{
			String _name = "Lime00Tip";
			String _text = "La Cal, elaborada exponiendo piedra blanda al calor, usa el límite de Materias Primas para controlar la producción. Es increíblemente útil para muchas aplicaciones diferentes.";
		}
		{
			String _name = "column2text12";
			String _text = "1 Piedra + ";
