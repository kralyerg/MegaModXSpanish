		{ String _name = "Watermill";					String _text = "Molino de Agua"; }
		{ String _name = "WatermillLwr";				String _text = "molino de agua"; }
		{ String _name = "WatermillTip";				String _text = "Un Molino de Agua produce harina a partir de grano, y debe construirse en el litoral. La harina no es comestible y puede llevarse a una panadería para prepararla como alimento o comerciarse. F para cambiar el aspecto."; }
		
		{ String _name = "Watermill3";					String _text = "Molino de Agua de Fibras"; }
		{ String _name = "Watermill3Lwr";				String _text = "molino de agua de fibras"; }
		{ String _name = "Watermill3Tip";				String _text = "Un Molino de Agua de Fibras es una forma más rápida de fabricar productos a partir de fibras, como tela, lino y seda, y debe construirse en el litoral."; }

		{ String _name = "Windmill";					String _text = "Molino de Viento Grande"; }
		{ String _name = "WindmillLwr";					String _text = "molino de viento grande"; }
		{ String _name = "WindmillTip";					String _text = "Un Molino de Viento Grande produce harina a partir de grano. La harina no es comestible y puede llevarse a una panadería para prepararla como alimento o comerciarse."; }

		{ String _name = "StoneWindmill";				String _text = "Molino de Viento Pequeño"; }
		{ String _name = "StoneWindmillLwr";			String _text = "Molino de viento pequeño"; }
		{ String _name = "StoneWindmillTip";			String _text = "Un Molino de Viento Pequeño produce harina a partir de grano. La harina no es comestible y puede llevarse a una panadería para prepararla como alimento o comerciarse. Este molino es más lento produciendo harina que el Molino de Viento Grande."; }

		{ String _name = "Oilpress";					String _text = "Prensa de Aceite"; }
		{ String _name = "OilpressLwr";					String _text = "prensa de aceite"; }
		{ String _name = "OilpressTip";					String _text = "Una Prensa de Aceite extrae aceite de aceitunas y semillas cosechadas de girasol, lino y algodón, además de grasa de ballena. El aceite de lámpara se prensa mejor a partir de aceite de ballena, pero puede fabricarse con otros orgánicos a un coste."; }

		{ String _name = "Apiary";						String _text = "Apiario"; }
		{ String _name = "ApiaryLwr";					String _text = "apiario"; }
		{ String _name = "ApiaryTip";					String _text = "Un Apiario produce miel como alimento o cera de abeja que se puede convertir en velas en una Cerería."; }

		{ String _name = "Bakery";						String _text = "Panadería"; }
		{ String _name = "BakeryLwr";					String _text = "panadería"; }
		{ String _name = "BakeryTip";					String _text = "Una Panadería produce una variedad de panes y pasteles de distinto valor nutricional."; }

		{ String _name = "Refinery";					String _text = "Azucarera"; }
		{ String _name = "RefineryLwr";					String _text = "azucarera"; }
		{ String _name = "RefineryTip";					String _text = "Una Azucarera procesa caña de azúcar y remolacha azucarera en azúcar, y savia de arce en jarabe. Puedes refinar aún más el jarabe de arce en azúcar, aunque esto es muy ineficiente y requiere casi el doble de materias primas."; }

		{ String _name = "Wharfship";					String _text = "Muelle y Barco"; }
		{ String _name = "WharfshipLwr";				String _text = "muelle y barco"; }
		{ String _name = "WharfshipTip";				String _text = "Un Muelle con su Barco es un edificio avanzado usado para pescar ballenas, focas y langostas en alta mar. Se necesita grasa de ballena para fabricar aceite de lámpara en una prensa de aceite, un objeto importante para fabricar algunos edificios avanzados."; }
		
		{ String _name = "Saltworks";					String _text = "Salinas"; }
		{ String _name = "SaltworksLwr";				String _text = "salinas"; }
		{ String _name = "SaltworksTip";				String _text = "Unas Salinas para fabricar sal a partir de agua de mar usando una bomba eolica y una gran olla hervidora."; }

		{ String _name = "Creamery";					String _text = "Lechería Vieja"; }
		{ String _name = "CreameryLwr";					String _text = "lechería vieja"; }
		{ String _name = "CreameryTip";					String _text = "La Lechería Vieja fabrica mantequilla, nata y queso a partir de leche. Los 3 productos los fabrica el lechero automáticamente cuando hay leche disponible."; }

		{ String _name = "CowBarn";					String _text = "Establo de Ordeño"; }
		{ String _name = "CowBarnLwr";					String _text = "establo de ordeño"; }
		{ String _name = "CowBarnTip";					String _text = "Un Establo de Ordeño produce leche. Necesitaras algunos recursos de animales domesticados para construirlo."; }

		{ String _name = "CowParlour";					String _text = "Sala de Lechería"; }
		{ String _name = "CowParlourLwr";				String _text = "sala de lechería"; }
		{ String _name = "CowParlourTip";				String _text = "Una Sala de Lechería fabrica mantequilla, nata y queso a partir de leche. Los 3 productos los fabrica el lechero automáticamente cuando hay leche disponible."; }

		{ String _name = "Preservists";					String _text = "Conservero"; }
		{ String _name = "PreservistsLwr";				String _text = "conservero"; }
		{ String _name = "PreservistsTip";				String _text = "Fabrica conservas como mermeladas y encurtidos a partir de frutas y verduras. Las mermeladas necesitan azúcar de una azucarera, los encurtidos necesitan licores de una destilería. La cristalería proviene de la cristalería."; }

