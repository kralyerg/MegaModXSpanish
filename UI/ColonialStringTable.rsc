		{ String _name = "cc17TheLocalTip";				String _text = "Una taberna de estilo antiguo, El Local sirve bebidas a todos los habitantes del pueblo."; }

		{ String _name = "cc17Bakery";					String _text = "Panadería"; }
		{ String _name = "cc17BakeryLwr";				String _text = "panadería"; }
		{ String _name = "cc17BakeryTip";				String _text = "La humilde Panadería donde panaderos cubiertos de harina trabajan frente a hornos calientes creando deliciosos productos horneados para que tu gente coma. La comida que preparan con sus recetas es mucho más saludable que comer alimentos crudos de la cosecha, y además rinde más que los ingredientes crudos por si solos."; }

		{ String _name = "cc17LumberYard";				String _text = "Aserradero"; }
		{ String _name = "cc17LumberYardLwr";				String _text = "aserradero"; }
		{ String _name = "cc17LumberYardTip";				String _text = "El Aserradero es un aserradero de estilo rústico que permite una mayor producción de leña y madera. Es casi tan rápido por trabajador como un aserradero normal, pero solo permite hasta 2 trabajadores."; }

