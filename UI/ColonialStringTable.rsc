		{ String _name = "Tobaccobarn";					String _text = "Granero de Curado"; }
		{ String _name = "TobaccobarnLwr";				String _text = "granero de curado"; }
		{ String _name = "TobaccobarnTip";				String _text = "Aquí es donde el tabaco se cura al aire para convertirlo en tabaco de pipa. Los productos terminados deben almacenarse en una Posada y Jardín, Taberna o Alambique para su consumo."; }

