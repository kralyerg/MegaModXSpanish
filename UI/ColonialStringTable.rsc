		{ String _name = "cc17EdiblesMarket";				String _text = "Mercado de Comestibles"; }
		{ String _name = "cc17EdiblesMarketLwr";			String _text = "mercado de comestibles"; }
		{ String _name = "cc17EdiblesMarketTip";			String _text = "El Mercado de Comestibles se especializa en adquirir todos los alimentos que se pueden comer sin necesidad de preparación. Los ingredientes usados en recetas, como harina, azúcar refinada o agua, no se pueden almacenar aqui."; }

		{ String _name = "cc17TradingPost";				String _text = "Puesto Comercial del Pueblo Viejo"; }
		{ String _name = "cc17TradingPostLwr";				String _text = "puesto comercial de la ciudad vieja"; }
		{ String _name = "cc17TradingPostTip";				String _text = "Este es un puesto comercial general para todas tus necesidades comerciales."; }

		{ String _name = "cc17RusticAbode";				String _text = "Morada Rústica"; }
		{ String _name = "cc17RusticAbodeLwr";				String _text = "morada rústica"; }
		{ String _name = "cc17RusticAbodeTip";				String _text = "Un pequeño hogar que permite alojar nuevas familias de hasta 4 personas. Sin embargo, una familia existente de cualquier tamaño puede mudarse aqui si es reubicada. Se puede mejorar a una Morada del Pueblo. Usa F para cambiar el aspecto."; }
		{ String _name = "RusticAbodeUpgradeTip";	String _text = "Mejora a una Morada del Pueblo. Proporciona alojamiento para 4 residentes, más calor y más espacio de almacenamiento. Se recuperarán algunos recursos del edificio existente."; }

		{ String _name = "cc17Market";					String _text = "Mercado del Pueblo Viejo"; }
		{ String _name = "cc17MarketLwr";				String _text = "Mercado del Pueblo Viejo"; }
		{ String _name = "cc17MarketTip";				String _text = "El Mercado del Pueblo Viejo es un mercado general que puede almacenar más objetos que un Mercado Rural estándar. Usa F para cambiar el aspecto."; }

