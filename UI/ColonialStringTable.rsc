		{ String _name = "cc17SeamstressGuildTip";			String _text = "El Gremio de Costureras es una tradición consagrada de personas que ofrecen servicios relacionados con prendas y ropa. El calor, al parecer, tiene un precio para los habitantes dispuestos a pagarlo."; }

		{ String _name = "cc17TheLocal";				String _text = "El Local"; }
