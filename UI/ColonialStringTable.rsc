		{ String _name = "Alegarden";					String _text = "Posada y Jardín"; }
		{ String _name = "AlegardenLwr";				String _text = "posada y jardín"; }
		{ String _name = "AlegardenTip";				String _text = "Una posada y jardín público es un lugar donde la gente se reune para todo tipo de diversión social. Este es un gran lugar de almacenamiento para todos los productos de alcohol, lujo y tabaco (como el tabaco de pipa). No se requiere un trabajador, pero ayudara a llevar los lujos al almacén para su consumo."; }
		
		{ String _name = "Taverna";						String _text = "Taberna Pequeña"; }
		{ String _name = "TavernaLwr";					String _text = "taberna pequeña"; }
		{ String _name = "TavernaTip";					String _text = "Proporciona almacenamiento y consumo de lujos para tu gente. Este es un pequeño lugar de almacenamiento y consumo para todos los productos de alcohol, lujo y tabaco (como el tabaco de pipa). No se requiere un trabajador, pero ayudara a llevar los lujos al almacén para su consumo."; }
		
		{ String _name = "TavernMedium";				String _text = "Taberna"; }
		{ String _name = "TavernMediumLwr";				String _text = "taberna"; }
		{ String _name = "TavernMediumTip";				String _text = "Un lugar donde la gente se reune para todo tipo de diversión social. Este es un lugar de almacenamiento y consumo para todos los productos de alcohol, lujo y tabaco (como el tabaco de pipa). No se requiere un trabajador, pero ayudara a llevar los lujos al almacén para su consumo."; }
		
		{ String _name = "coffeehouse";					String _text = "Casa de Café"; }
		{ String _name = "coffeehouseLwr";				String _text = "casa de café"; }
		{ String _name = "coffeehouseTip";				String _text = "Aquí se puede preparar café recien hecho para satisfacer los gustos de la clientela. También es un lugar de almacenamiento y consumo para todos los productos de alcohol, lujo y tabaco (como el tabaco de pipa). No se requiere un trabajador, pero podrá preparar café aquí a partir de granos de café."; }

		{ String _name = "Tavern";						String _text = "Cervecería"; }
		{ String _name = "TavernLwr";					String _text = "cervecería"; }
		{ String _name = "TavernTip";					String _text = "Elabora alcohol y hace felices a los ciudadanos. Los productos creados deben ir a una Posada y Jardín, Taberna o Alambique para su consumo."; }

		{ String _name = "SWBrewery";					String _text = "Cervecería de Muelle"; }
		{ String _name = "SWBreweryLwr";				String _text = "cervecería de muelle"; }
		{ String _name = "SWBreweryTip";				String _text = "Elabora alcohol y hace felices a los ciudadanos. Los productos creados deben ir a una Posada y Jardín, Taberna o Alambique para su consumo."; }

		{ String _name = "Winery";						String _text = "Bodega de Vinos"; }
