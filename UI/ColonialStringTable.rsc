		{ String _name = "cc1DeadBodyTip";				String _text = "Cuerpo sin vida."; }

		{ String _name = "cc17BH";					String _text = "Pensión Vieja"; }
		{ String _name = "cc17BHLwr";					String _text = "pensión vieja"; }
		{ String _name = "cc17BHTip";					String _text = "Proporciona un lugar temporal para vivir a las personas sin hogar. Misma capacidad que la Pensión normal."; }

		{ String _name = "cc17Stable";					String _text = "Establo"; }
		{ String _name = "cc17StableLwr";				String _text = "establo"; }
		{ String _name = "cc17StableTip";				String _text = "Para la producción de animales domesticados."; }

		{ String _name = "cc17WS";					String _text = "Pastor Salvaje"; }
		{ String _name = "cc17WSLwr";					String _text = "Pastor Salvaje"; }
		{ String _name = "cc17WSTip";					String _text = "Recorre toda la tierra buscando animales para domesticar. Tarda mucho tiempo. Eventualmente puedes agotar la reserva local de animales disponibles, momento en el que este edificio puede mejorarse a un Recolector normal o eliminarse."; }

		{ String _name = "cc17WSG";					String _text = "Recolector Salvaje"; }
		{ String _name = "cc17WSGLwr";					String _text = "Recolector salvaje"; }
		{ String _name = "cc17WSGTip";					String _text = "Hombre recolector, hombre recolector, haciendo lo que un recolector puede hacer."; }

		{ String _name = "cc17Blacksmith";				String _text = "Herrería Municipal"; }
		{ String _name = "cc17BlacksmithLwr";				String _text = "herrería municipal"; }
		{ String _name = "cc17BlacksmithTip";				String _text = "Una herrería con todas las opciones de producción avanzadas. Funciona igual que la Herrería Grande y la Herrería Rural. Un taller enorme con hasta dos herreros, construido con el tamaño y equipado con lo necesario para fabricar muchos tipos de herramientas, además de producir mosquetes para la defensa de la colonia."; }

