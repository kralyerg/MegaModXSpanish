		{ String _name = "MusketRangeTip";				String _text = "Aqui es donde los soldados de tu colonia entrenan para ser los mejores y estar preparados para lo que el mundo les depare. Durante el entrenamiento necesario, se produciran recursos vitales para la supervivencia de tu colonia (como herramientas, ropa y combustible)."; }
		{ String _name = "MusketRangeBoxTip";			String _text = "Requiere: pfennig y galleta dura. Produce: surtido aleatorio de herramienta de acero, leña, chaqueton, combustible para horno, carbon vegetal."; }

