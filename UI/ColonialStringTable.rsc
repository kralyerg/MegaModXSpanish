		{ String _name = "WaterTower";					String _text = "Torre de Agua"; }
		{ String _name = "WaterTowerLwr";				String _text = "torre de agua"; }
		{ String _name = "WaterTowerTip";				String _text = "Una Torre de Agua proporciona agua limpia que se puede usar en la Cocina de Taberna para llenar cantimploras de hojalata; a la gente le encanta. La gente puede beber agua directamente para sobrevivir, pero tendrá un impacto negativo en su salud."; }

	// ##########################################
	// ##    Resource production buildings    ##
	// ##########################################
		{ String _name = "SawmillBL";					String _text = "Aserradero de Rueda Hidráulica"; }
		{ String _name = "SawmillBLLwr";				String _text = "aserradero"; }
		{ String _name = "SawmillBLTip";				String _text = "Produce madera o leña, y permite trabajar hasta a tres taladores. La velocidad de trabajo muy rápida agotará rápidamente los troncos de madera disponibles."; }
		
		{ String _name = "Sawmill";						String _text = "Aserradero de Rueda Hidráulica"; }
		{ String _name = "SawmillLwr";					String _text = "Aserradero de rueda hidráulica"; }
		{ String _name = "SawmillTip";					String _text = "Un aserradero impulsado por rueda hidráulica. Produce madera o leña, y permite trabajar hasta a tres taladores. La velocidad de trabajo muy rápida agotará rápidamente los troncos de madera disponibles."; }

		{ String _name = "Chopper";						String _text = "Cortadora"; }
		{ String _name = "ChopperLwr";					String _text = "cortadora"; }
		{ String _name = "ChopperTip";					String _text = "Un área más pequeña e informal donde se corta madera."; }
		
		{ String _name = "Workcamp";					String _text = "Campamento de Trabajo"; }
		{ String _name = "WorkcampLwr";					String _text = "campamento de trabajo"; }
		{ String _name = "WorkcampTip";					String _text = "Lo militar no es solo guerra: la construcción y el desarrollo del paisaje siempre han sido responsabilidad de las fuerzas militares en tiempos de paz. Este campamento de trabajo convierte la paga básica, las herramientas y la energía de la guarnición inquieta en recursos básicos."; }
		{ String _name = "WorkcampBoxTip";				String _text = "Requiere: pfennig y herramientas de hierro. Produce: surtido aleatorio de hierro, vidrio, carbón, ladrillo, cerámica, troncos de madera."; }

		{ String _name = "LargeSmithy";					String _text = "Herrería Grande"; }
		{ String _name = "LargeSmithyLwr";				String _text = "herrería grande"; }
		{ String _name = "LargeSmithyTip";				String _text = "La Herrería Grande es un taller enorme con hasta dos herreros, construido con el tamaño y equipado con lo necesario para fabricar muchos tipos de herramientas, además de producir mosquetes para la defensa de la colonia."; }
		
		{ String _name = "RuralSmith";					String _text = "Herrería Rural"; }
		{ String _name = "RuralSmithLwr";				String _text = "herrería rural"; }
		{ String _name = "RuralSmithTip";				String _text = "La Herrería Rural es un taller enorme con hasta dos herreros, construido con el tamaño y equipado con lo necesario para fabricar muchos tipos de herramientas, además de producir mosquetes para la defensa de la colonia."; }

		{ String _name = "Clothier";					String _text = "Modistería"; }
		{ String _name = "ClothierLwr";					String _text = "modistería"; }
		{ String _name = "ClothierTip";					String _text = "Una Modistería es una Sastrería mejorada que fabrica ropa de mayor calidad, más cálida y de mayor valor comercial."; }
		
		{ String _name = "Stitcher";					String _text = "Fabricante de Uniformes"; }
		{ String _name = "StitcherLwr";					String _text = "fabricante de uniformes"; }
		{ String _name = "StitcherTip";					String _text = "El Fabricante de Uniformes es un especialista militar centrado en la producción de orgullosos uniformes militares. Estos uniformes son esenciales para la moral de los soldados en batalla y un componente importante de tu fuerza militar. Solo fabrica librea completa."; }
		
		{ String _name = "Quartermaster";				String _text = "Intendente"; }
		{ String _name = "QuartermasterLwr";			String _text = "intendente"; }
		{ String _name = "QuartermasterTip";			String _text = "El Intendente es la primera y más importante pieza que debes construir al establecer una presencia militar en una nueva área. Cuando está atendido, agentes de tu marina traerán suministros militares de forma constante."; }

		{ String _name = "Firebundler";					String _text = "Cobertizo de Haces"; }
		{ String _name = "FirebundlerLwr";				String _text = "cobertizo de haces"; }
		{ String _name = "FirebundlerTip";				String _text = "En el cobertizo de haces, se recolectan orgánicos y se cortan en haces utilizables como combustible para fuegos"; }

		{ String _name = "Shorepit";					String _text = "Casa de Orilla"; }
		{ String _name = "ShorepitLwr";					String _text = "casa de orilla"; }
		{ String _name = "ShorepitTip";					String _text = "Una Casa de Orilla es donde se puede excavar arena y arcilla para su posterior procesamiento en una cristalería o ladrillería, y también donde se pueden encontrar ranas y tortugas."; }
		
		{ String _name = "Chandlery";					String _text = "Cerería"; }
		{ String _name = "ChandleryLwr";				String _text = "cerería"; }
		{ String _name = "ChandleryTip";				String _text = "Una Cerería se usa para fabricar velas a partir de cera de abeja, grasa de ballena o sebo."; }

		{ String _name = "PearlStand";					String _text = "Cazador de Perlas"; }
		{ String _name = "PearlStandLwr";				String _text = "cazador de perlas"; }
		{ String _name = "PearlStandTip";				String _text = "Un Cazador de Perlas puede encontrar una perla rara si se le dan suficientes ostras."; }

		{ String _name = "Glassworkers";				String _text = "Cristalería"; }
		{ String _name = "GlassworkersLwr";				String _text = "cristalería"; }
		{ String _name = "GlassworkersTip";				String _text = "Una Cristalería es donde la arena se calienta en un horno y se convierte en vidrio y productos de vidrio."; }

		{ String _name = "KilnBuilding";				String _text = "Quemador de Pilas"; }
		{ String _name = "KilnBuildingLwr";				String _text = "quemador de pilas"; }
		{ String _name = "KilnBuildingTip";				String _text = "La madera o el carbón en capas se apilan juntos y se queman de dentro hacia fuera para convertirlos en combustible. Una buena fuente de combustible ligero para calentar hogares."; }
		{ String _name = "KilnBuildingUpgradeTip";		String _text = "Mejora a una Ladrillería para desbloquear opciones de construcción avanzadas. Se recuperarán algunos recursos del edificio existente."; }

		{ String _name = "BrickBuilding";				String _text = "Ladrillería"; }
		{ String _name = "BrickBuildingLwr";			String _text = "ladrillería"; }
		{ String _name = "BrickBuildingTip";			String _text = "Usando un horno, la Ladrillería crea ladrillos moldeados y cocidos para edificios avanzados."; }

		{ String _name = "Ropery";						String _text = "Cordelería"; }
		{ String _name = "RoperyLwr";					String _text = "cordelería"; }
		{ String _name = "RoperyTip";					String _text = "Una Cordelería es donde el cáñamo, el lino o los juncos se trenzan en cuerda. Fabricar cuerda de cáñamo requiere algo menos de materias primas que el lino, y se necesitan grandes cantidades de juncos."; }

		{ String _name = "Silkwormhut";					String _text = "Cabaña de Gusanos de Seda"; }
		{ String _name = "SilkwormhutLwr";				String _text = "cabaña de gusanos de seda"; }
		{ String _name = "SilkwormhutTip";				String _text = "Una Cabaña de Gusanos de Seda cría gusanos de seda para producir seda y, como último recurso, para alimento. Requiere huevos de gusano de seda de un comerciante para construirse. Una vez construida, los gusanos de seda necesitan hojas de morera blanca como alimento, que se pueden comerciar u obtener de un huerto."; }

		{ String _name = "Weavers";						String _text = "Tejedores"; }
		{ String _name = "WeaversLwr";					String _text = "tejedores"; }
		{ String _name = "WeaversTip";					String _text = "Un tejedor fabrica lino, tela y seda a partir de lino, algodón y capullos de gusano de seda. También pueden confeccionar alfombras."; }

