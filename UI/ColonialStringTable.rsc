		{ String _name = "NewTrees2LiteAEDesc";		String _text = "Versión ligera para mejor rendimiento. Una partida estándar Adán y Eva con solo árboles nuevos del mod, excluyendo palmeras. Se proporciona una pequeña cantidad de comida, leña y ropa en una pequeña carreta de almacenamiento. No se ha construido ninguna estructura, no hay semillas ni ganado disponibles inicialmente: tendrás que sobrevivir y conseguirlo todo."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] La Maldición de la Llama Dorada - Fácil"; }
		{ String _name = "LlamaEasyDesc";		String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de Banished. ¿Qué es la Llama Dorada? ¿Qué misterios guarda? ¿Te atreves a explorar su turbio interior? Esta partida comienza con la configuración Fácil habitual, pero incluye la opción de aventurarte en busca de un tesoro. "; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] La Maldición de la Llama Dorada - Media"; }
		{ String _name = "LlamaMediumDesc";		String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de Banished. ¿Qué es la Llama Dorada? ¿Qué misterios guarda? ¿Te atreves a explorar su turbio interior? Esta partida comienza con la configuración Media habitual, pero incluye la opción de aventurarte en busca de un tesoro."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] La Maldición de la Llama Dorada - Difícil"; }
		{ String _name = "LlamaHardDesc";		String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de Banished. ¿Qué es la Llama Dorada? ¿Qué misterios guarda? ¿Te atreves a explorar su turbio interior? Esta partida comienza con la configuración Difícil habitual, pero incluye la opción de aventurarte en busca de un tesoro. "; }

		{ String _name = "LlamaAEName";			String _text = "[CC] La Maldición de la Llama Dorada - Adan y Eva"; }
		{ String _name = "LlamaAEDesc";			String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de Banished. ¿Qué es la Llama Dorada? ¿Qué misterios guarda? ¿Te atreves a explorar su turbio interior? Esta partida comienza con la configuración Adán y Eva habitual, pero incluye la opción de aventurarte en busca de un tesoro. "; }

		{ String _name = "OldCastleHardName";		String _text = "[CC] Castillo Antiguo - Difícil"; }
		{ String _name = "OldCastleHardDesc";		String _text = "Comienza en el emplazamiento de un Castillo Antiguo que ofrece un enorme potencial de almacenamiento. Se ha descubierto algo de comida conservada y una pequeña cantidad de ropa, herramientas y leña. No hay semillas ni ganado presentes."; }

		{ String _name = "BayouEasyName";		String _text = "[CC] Pantano - Fácil"; }
		{ String _name = "BayouEasyDesc";		String _text = "El Pantano viene con todo lo necesario para poner en marcha un pueblo de muelles. Se proporciona algo de arroz, herramientas, ropa y leña. También hay gallinas cerca."; }

		{ String _name = "PlainsEasyName";		String _text = "Llanuras - Fácil"; }
		{ String _name = "PlainsEasyDesc";		String _text = "Prueba"; }

		{ String _name = "FantasyEasyName";		String _text = "[CC] Todo lo Salvaje - Fácil"; }
		{ String _name = "FantasyEasyDesc";		String _text = "La tierra está cubierta de todo tipo de recursos alimenticios naturales, listos para ser recolectados en estado salvaje. Las rocas y el hierro también reaparecen. Este mapa es extremadamente fácil e irrealista debido a la abundancia de recursos antinaturales que crecen constantemente por toda la naturaleza. Por lo demas, es un inicio fácil típico."; }

		{ String _name = "FantasyAEName";		String _text = "[CC] Todo lo Salvaje - Adan y Eva"; }
		{ String _name = "FantasyAEDesc";		String _text = "La tierra está cubierta de todo tipo de recursos alimenticios naturales, listos para ser recolectados en estado salvaje. Las rocas y el hierro también reaparecen. Este mapa es extremadamente fácil e irrealista debido a la abundancia de recursos antinaturales que crecen constantemente por toda la naturaleza. Por lo demas, es un inicio típico de Adan y Eva."; }

		{ String _name = "ShipwreckHardName";		String _text = "[CC] Naufragio - Difícil"; }
		{ String _name = "ShipwreckHardDesc";		String _text = "Naufragados en una tierra desconocida, tu gente solo cuenta con su ingenio y lo que puedan rescatar del naufragio."; }

		{ String _name = "ShipwreckElDoradoHardName";	String _text = "[CC] Naufragio - El Dorado - Difícil"; }
		{ String _name = "ShipwreckElDoradoHardDesc";	String _text = "Naufragados en una tierra desconocida, tu gente solo cuenta con su ingenio y lo que puedan rescatar del naufragio. Una partida con solo árboles nuevos del mod."; }

		{ String _name = "ShipwreckJungleHardName";	String _text = "[CC] Naufragio - Selva - Difícil"; }
		{ String _name = "ShipwreckJungleHardDesc";	String _text = "Naufragados en una tierra desconocida, tu gente solo cuenta con su ingenio y lo que puedan rescatar del naufragio. Una partida con solo árboles de selva del mod."; }

		{ String _name = "ShipwreckPinesHardName";	String _text = "[CC] Naufragio - Pinares del Norte - Difícil"; }
		{ String _name = "ShipwreckPinesHardDesc";	String _text = "Naufragados en una tierra desconocida, tu gente solo cuenta con su ingenio y lo que puedan rescatar del naufragio. Una partida con solo pinos del mod."; }

		{ String _name = "ShipwreckMediumName";		String _text = "[CC] Naufragio - Media+"; }
		{ String _name = "ShipwreckMediumDesc";		String _text = "Naufragados en una tierra desconocida, se rescató del naufragio una pequeña cantidad de madera y piedra, junto con una semilla y ganado."; }

		{ String _name = "ShipwreckElDoradoMediumName";	String _text = "[CC] Naufragio - El Dorado - Media+"; }
		{ String _name = "ShipwreckElDoradoMediumDesc";	String _text = "Naufragados en una tierra desconocida, se rescató del naufragio una pequeña cantidad de madera y piedra, junto con una semilla y ganado."; }

		{ String _name = "ShipwreckJungleMediumName";	String _text = "[CC] Naufragio - Selva - Media+"; }
		{ String _name = "ShipwreckJungleMediumDesc";	String _text = "Naufragados en una tierra desconocida, se rescató del naufragio una pequeña cantidad de madera y piedra, junto con una semilla y ganado."; }

		{ String _name = "ShipwreckPinesMediumName";	String _text = "[CC] Naufragio - Pinares del Norte - Media+"; }
		{ String _name = "ShipwreckPinesMediumDesc";	String _text = "Naufragados en una tierra desconocida, se rescató del naufragio una pequeña cantidad de madera y piedra, junto con una semilla y ganado."; }

		{ String _name = "AbandonedJungleHardName";	String _text = "[CC] Aldea Abandonada - Selva"; }
		{ String _name = "AbandonedJungleHardDesc";	String _text = "En lo profundo de la selva, tu gente encuentra los restos de un asentamiento independiente anterior. Tienes la misma cantidad de recursos disponibles que en un inicio Difícil estándar, aunque algunas casas ya están construidas o parcialmente construidas."; }

		{ String _name = "AbandonedPinesHardName";	String _text = "[CC] Aldea Abandonada - Pinares del Norte"; }
		{ String _name = "AbandonedPinesHardDesc";	String _text = "En lo profundo de la naturaleza salvaje, tu gente encuentra los restos de un asentamiento independiente anterior. Tienes la misma cantidad de recursos disponibles que en un inicio Difícil estándar, aunque algunas casas ya están construidas o parcialmente construidas."; }

