	//STARTING CONDITIONS
		{ String _name = "CCcustom1Name";		String _text = "Carta Colonial"; }
		{ String _name = "CCcustom1Desc";		String _text = "La descripción de Carta Colonial va aqui"; }

		{ String _name = "CCAdamEve";			String _text = "[CC] Adan y Eva"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Comienza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en una pequeña carreta de almacenamiento. No se ha construido ninguna estructura, no hay semillas ni ganado disponibles inicialmente: tendrás que sobrevivir y conseguirlo todo."; }

		{ String _name = "CCSilkRoad";			String _text = "[CC] Ruta de la Seda - Fácil"; }
		{ String _name = "CCSilkRoadDesc";		String _text = "Comienza con la capacidad de alimentar y criar gusanos de seda para obtener su preciada seda. Empieza con seis familias. Se proporciona una gran cantidad de ropa, comida, leña, materiales de construcción y herramientas. Las viviendas y las zonas de almacenamiento ya han sido construidas."; }
		
		{ String _name = "CCSilkRoadMed";		String _text = "[CC] Ruta de la Seda - Media"; }
		{ String _name = "CCSilkRoadMedDesc";		String _text = "Comienza con la capacidad de alimentar y criar gusanos de seda para obtener su preciada seda. Empieza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento."; }

		{ String _name = "CCSilkRoadHard";		String _text = "[CC] Ruta de la Seda - Difícil"; }
		{ String _name = "CCSilkRoadHardDesc";		String _text = "Comienza con la capacidad de alimentar y criar gusanos de seda para obtener su preciada seda. Una partida difícil comienza con cuatro familias. Se proporciona una pequeña cantidad de ropa, comida, leña y herramientas. Las semillas de morera blanca son las únicas disponibles."; }
		
		{ String _name = "CCMine";			String _text = "[CC] Mina"; }

		{ String _name = "CCMineDesc";			String _text = "Minería única para objetos valiosos."; }

		{ String _name = "CCMediumPlus";		String _text = "[CC] Media+"; }
		{ String _name = "CCMediumPlusDesc";		String _text = "Anade Ganado. Una partida media+ comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento. Hay algunas semillas disponibles para campos y huertos, así como un rebaño de ganado."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Misionero"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Una partida de Misionero comienza con una Casa Parroquial y tres familias, 2 de ellas sin educación. Ya hay 2 casas construidas y se proporcionan algunos suministros básicos. Hay una carreta de almacenamiento disponible. Hay algunas semillas disponibles para campos y huertos, así como un rebaño de ganado."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Nueva Frontera"; }
		{ String _name = "CCFortDesc";		String _text = "Nueva Frontera te sitúa en un puesto fronterizo junto a una aldea nativa americana amistosa. Defiende y cuida a tus ciudadanos y tu leyenda se contará en el oeste para siempre. Esta partida comienza con 3 familias y ya se ha construido un pequeño fuerte con algunos suministros. Incluye la opción de descubrir tesoros en un terreno ceremonial."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Aldea Nativa - Difícil"; }
		{ String _name = "CCFortHardDesc";		String _text = "El inicio de Aldea Nativa requiere tener buenas relaciones con la tribu nativa de la zona y es un comienzo bastante difícil. La aldea requerirá recursos (mejoras) para mostrar tu amistad, y después podrás elegir como interactuar con los edificios. Como extranjeros en esta tierra, tienen mucho que aprender y ganar buscando aliados en lugar de enemigos."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Aldea Nativa - Adan y Eva"; }
		{ String _name = "CCFortAEDesc";		String _text = "Comienza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en una pequeña carreta de almacenamiento. El inicio de Aldea Nativa requiere tener buenas relaciones con la tribu nativa de la zona y es un comienzo bastante difícil. La aldea requerirá recursos (mejoras) para mostrar tu amistad, y después podrás elegir como interactuar con los edificios. Como extranjeros en esta tierra, tienen mucho que aprender y ganar buscando aliados en lugar de enemigos."; }

		{ String _name = "PalmsOnlyEasyName";		String _text = "[CC] Antillas - Fácil"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Una partida estándar Fácil con solo palmeras y árboles tropicales. Una partida fácil comienza con seis familias. Se proporciona una gran cantidad de ropa, comida, leña, materiales de construcción y herramientas. Las viviendas y las zonas de almacenamiento ya han sido construidas. Hay semillas disponibles para campos y huertos, así como un rebaño de ganado."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "[CC] Antillas - Media"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Una partida estándar Media con solo palmeras y árboles tropicales. Una partida media comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento. Hay algunas semillas disponibles para campos y huertos."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "[CC] Antillas - Difícil"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Una partida estándar Difícil con solo palmeras y árboles tropicales. Una partida difícil comienza con cuatro familias. Se proporciona una pequeña cantidad de ropa, comida, leña y herramientas. No hay semillas disponibles para la agricultura."; }
		
		{ String _name = "PalmsOnlyHardFewName";		String _text = "[CC] Antillas Escasas - Difícil"; }
		{ String _name = "PalmsOnlyHardFewDesc";		String _text = "Una partida estándar Difícil con escasas palmeras y árboles tropicales, y poca piedra y mineral en superficie. Una partida difícil comienza con cuatro familias. Se proporciona una pequeña cantidad de ropa, comida, leña y herramientas. No hay semillas disponibles para la agricultura."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "[CC] Antillas - Adan y Eva"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "Una partida estándar Adán y Eva con solo palmeras y árboles tropicales. Comienza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en una pequeña carreta de almacenamiento. No se ha construido ninguna estructura, no hay semillas ni ganado disponibles inicialmente: tendrás que sobrevivir y conseguirlo todo."; }

