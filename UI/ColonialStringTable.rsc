		{ String _name = "AbandonedRusticAbodeTip";			String _text = "Morada Rústica Abandonada. Este texto no se ve si no hay un icono de barra de herramientas para ella."; }

		{ String _name = "cc17WaterTank";				String _text = "Depósito de Agua Municipal"; }
