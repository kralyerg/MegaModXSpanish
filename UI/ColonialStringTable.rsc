		{ String _name = "FuelRefinery";				String _text = "Refinería de Combustible"; }
		{ String _name = "FuelRefineryLwr";				String _text = "refinería de combustible"; }
		{ String _name = "FuelRefineryTip";				String _text = "Una Refinería de Combustible toma recursos naturales combustibles y los convierte en una forma más caliente y deseable para las fundiciones industriales (más caliente, arde más tiempo)."; }
		
		{ String _name = "IndustrySmall2";				String _text = "Refinería de Combustible Pequeña"; }
		{ String _name = "IndustrySmall2Lwr";			String _text = "refinería de combustible pequeña"; }
		{ String _name = "IndustrySmall2Tip";			String _text = "Fabrica combustible para horno. Solo puede trabajar aquí 1 trabajador, y es algo menos eficiente que la Refinería de Combustible más grande (por trabajador)."; }
		
		{ String _name = "IndustrySmall";				String _text = "Fundición de Hierro Pequeña"; }
		{ String _name = "IndustrySmallLwr";			String _text = "fundición de hierro pequeña"; }
		{ String _name = "IndustrySmallTip";			String _text = "Una Fundición de Hierro Pequeña solo produce hierro a partir de mena de hierro y combustible para horno. Solo puede trabajar aquí 1 trabajador, y es menos eficiente que los edificios más grandes Fundición y Forja."; }

		{ String _name = "Forge";						String _text = "Forja"; }
		{ String _name = "ForgeLwr";					String _text = "forja"; }
		{ String _name = "ForgeTip";					String _text = "Crea hierro a partir de mena de hierro. También crea estaño, cobre, bronce y peltre. Puede fabricar cañones, viguetas, estatuas de hierro y estatuas de bronce, así como herramientas de bronce. No requiere colocación en el agua."; }
		
		{ String _name = "SWShack";						String _text = "Pesquería de Muelle"; }
		{ String _name = "SWShackLwr";					String _text = "pesquería de muelle"; }
		{ String _name = "SWShackTip";					String _text = "Una Pesquería construida en un Muro de Muelle. Cuanta más agua cercana, más peces se capturan."; }
		
		{ String _name = "Tannery";						String _text = "Curtiduría"; }
		{ String _name = "TanneryLwr";					String _text = "curtiduría"; }
		{ String _name = "TanneryTip";					String _text = "Usa sal y cuero para crear cuero curado, necesario para algunas prendas avanzadas y que aumenta el valor comercial."; }

		{ String _name = "Foundry";						String _text = "Fundición"; }
		{ String _name = "FoundryLwr";					String _text = "fundición"; }
		{ String _name = "FoundryTip";					String _text = "Crea hierro a partir de mena de hierro. También crea estaño, cobre, bronce y peltre. Puede fabricar cañones, viguetas, estatuas de hierro y estatuas de bronce, así como herramientas de bronce. Esto se hace vertiendo metales fundidos en moldes. Impulsada por una rueda hidráulica y algo más eficiente que la Forja."; }


