		{ String _name = "DSJaBJettyHome2x2Tip";			String _text = "Un pequeño hogar de muelle para 3 ciudadanos, los pequeños aposentos de esta casa de trabajadores permiten un uso moderado del calor y el combustible. 700 de capacidad. 2x2. Requiere 29 de trabajo para construir. Se puede construir sobre agua o en tierra - asegúrate de que la puerta principal sea accesible para los ciudadanos. Calefacción: temp. para combustible 50 grados, calor del combustible 68."; }
		{ String _name = "DSJaBJettyHome2x2Info";		String _text = "Casa de Trabajadores"; }
				
		{ String _name = "DSJaBJettyHome3x2";				String _text = "Hogar de Trabajadores"; }
