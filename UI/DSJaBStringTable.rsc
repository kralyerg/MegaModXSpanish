		// Jetty Homes menu
		{ String _name = "DSJaBJettyHomesmenuTip";		String _text = "Vivienda de Muelle -- tecla F para variantes. Se puede construir sobre agua o en tierra - asegúrate de que la puerta principal sea accesible para los ciudadanos."; }
		
		{ String _name = "DSJaBJettyHomeWS";				String _text = "Choza de Trabajadores"; }
		{ String _name = "DSJaBJettyHomeWSLwr";				String _text = "choza de trabajadores"; }
		{ String _name = "DSJaBJettyHomeWSTip";				String _text = "Un pequeño hogar de muelle para 2 ciudadanos, aunque carece de espacio y no puede acomodar a una familia creciente, la choza de trabajadores tiene la ventaja de un mejor uso del calor y el combustible que las otras opciones de vivienda para trabajadores. 500 de capacidad. 1x2. Requiere 21 de trabajo para construir. Se puede construir sobre agua o en tierra - asegúrate de que la puerta principal sea accesible para los ciudadanos. Calefacción: temp. para combustible 50 grados, calor del combustible 70."; }
				
		{ String _name = "DSJaBJettyHome2x2";				String _text = "Casa de Trabajadores"; }
