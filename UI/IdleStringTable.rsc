		{
			String _name = "Huoshan";
			String _text = "[IC]Volcán Sagrado - Astor Yao";
		}
		{
			String _name = "HuoshanLwr";
			String _text = "[IC]Volcán Sagrado - Astor Yao";
		}
		{
			String _name = "HuoshanTip";
			String _text = "Un continente de tiempos antiguos. Elige el mejor terreno con más llanuras. Como se vive cerca del Volcán Sagrado, la gente de esta zona vive hasta los 60 años y tiene hijos entre los 10 y los 50 años, pero tiene mayor velocidad y capacidad de manejo, por lo que no se recomienda traer refugiados. La partida comienza en las inmediaciones del Volcán Sagrado, y este puede bendecir la herramienta maldita como herramienta sagrada (puede ser usada para siempre por alguien).";
		}
