		{ String _name = "DSNormalStoneBridgeLTip";		String _text = "Lado izquierdo del puente de construcción normal, colócalo de orilla a orilla. Con el mapa orientado al norte, este puente estará a la izquierda al cruzar en dirección norte-sur. En dirección este-oeste, este puente estará en la parte superior o lado norte del puente. Este puente no incluye las rampas/escaleras de los extremos, debes construirlas por separado. Requiere 5 de trabajo por casilla para construir"; }
		
		{ String _name = "DSNormalStoneBridgeR";		String _text = "Puente de piedra derecho"; }
