//buildings

		{ String _name = "StorageBarnStone";				String _text = "Almacén de Depósito"; }
		{ String _name = "StorageBarnStoneLwr";				String _text = "almacén de depósito"; }
		{ String _name = "StorageBarnStoneTip";				String _text = "Proporciona una mayor cantidad de almacenamiento para toda la gama de productos y recursos."; }
		
		{ String _name = "TradeWarehouse";					String _text = "Depósito de Recursos"; }
		{ String _name = "TradeWarehouseLwr";				String _text = "depósito de recursos"; }
		{ String _name = "TradeWarehouseTip";				String _text = "Almacenamiento ajustable para la gama disponible de productos y recursos. Debes tener al menos 1 unidad de un tipo de producto para que aparezca su botón de almacenamiento. Los objetos almacenados en este edificio solo se liberarán a tu ciudad cuando reduzcas manualmente su número. Los objetos almacenados no están disponibles libremente para la gente sin tu intervención."; }

		{ String _name = "LargeSmithy";						String _text = "Herrería Grande"; }
		{ String _name = "LargeSmithyLwr";					String _text = "herrería grande"; }
		{ String _name = "LargeSmithyTip";					String _text = "Una Herrería Grande fabrica productos avanzados, incluidas Herramientas de Acero y Vigas, necesarios para algunos edificios avanzados."; }

		{ String _name = "KilnBuilding";					String _text = "Quemador de Pilas"; }
		{ String _name = "KilnBuildingLwr";					String _text = "quemador de pilas"; }
		{ String _name = "KilnBuildingTip";					String _text = "La madera o el carbón en capas se apilan juntos y se queman convirtiéndose en combustible de dentro hacia afuera. Una buena fuente de combustible ligero para calentar hogares o trabajar."; }
		
		{ String _name = "BrickBuilding";					String _text = "Ladrillera"; }
		{ String _name = "BrickBuildingLwr";				String _text = "ladrillera"; }
		{ String _name = "BrickBuildingTip";				String _text = "Usando un horno, la Ladrillera crea ladrillos moldeados al calor, necesarios para algunos edificios avanzados y el camino de ladrillo."; }
		
		{ String _name = "Abbey";							String _text = "Abadía"; }
		{ String _name = "AbbeyLwr";						String _text = "abadía"; }
		{ String _name = "AbbeyTip";						String _text = "Una Abadía alberga monjes que recolectan bayas y hierbas, y elaboran cerveza. Los monjes son ingeniosos y fabrican sus productos con ingredientes locales, sin necesitar asistencia ni entregas de productos."; }

		{ String _name = "Ropery";							String _text = "Cordelería"; }
		{ String _name = "RoperyLwr";						String _text = "cordelería"; }
		{ String _name = "RoperyTip";						String _text = "Una Cordelería es donde el cáñamo y el lino se convierten en cuerda. Hacer cuerda con cáñamo requiere ligeramente menos materia prima que con lino."; }
		
		{ String _name = "Tinyshack";						String _text = "Choza Diminuta"; }
		{ String _name = "TinyshackLwr";					String _text = "choza diminuta"; }
		{ String _name = "TinyshackTip";					String _text = "Una vivienda pequeña y básica que permitirá a las nuevas familias crecer hasta un máximo de 3 personas. Sin embargo, una familia existente de cualquier tamaño puede mudarse aquí si está siendo reubicada."; }
		
		{ String _name = "Tinyhouse";						String _text = "Casa Diminuta"; }
		{ String _name = "TinyshackLwr";					String _text = "casa diminuta"; }
		{ String _name = "TinyhouseTip";					String _text = "Una vivienda pequeña y básica que permitirá a las nuevas familias crecer hasta un máximo de 4 personas. Sin embargo, una familia existente de cualquier tamaño puede mudarse aquí si está siendo reubicada. Más cálida y cómoda que una choza diminuta."; }
		
		{ String _name = "Townhouse";						String _text = "Residencia Grande"; }
		{ String _name = "TownhouseLwr";					String _text = "residencia grande"; }
		{ String _name = "TownhouseTip";					String _text = "La Residencia Grande puede albergar a una familia de 6 con gran calidez y comodidad."; }
		
		{ String _name = "Townhouse2";						String _text = "Mansión Señorial"; }
		{ String _name = "Townhouse2Lwr";					String _text = "mansión señorial"; }
		{ String _name = "Townhouse2Tip";					String _text = "La Mansión Señorial puede albergar a una familia de 7 con gran calidez y comodidad."; }
		
		{ String _name = "Townhouse3";						String _text = "Mansión"; }
		{ String _name = "Townhouse3Lwr";					String _text = "mansión"; }
		{ String _name = "Townhouse3Tip";					String _text = "La Mansión puede albergar a una familia de 8 con gran calidez y comodidad."; }
		
		{ String _name = "Townhouse4";						String _text = "Finca"; }
		{ String _name = "Townhouse4Lwr";					String _text = "finca"; }
		{ String _name = "Townhouse4Tip";					String _text = "La Finca es un edificio de élite y puede albergar a una familia de 8 con la máxima calidez y comodidad."; }

		{ String _name = "SmalltownhouseA";					String _text = "Morada Urbana"; }
		{ String _name = "SmalltownhouseALwr";				String _text = "morada urbana"; }
		{ String _name = "SmalltownhouseATip";				String _text = "Una Morada Urbana es un hogar que permitirá a nuevas familias de hasta 4 personas. Sin embargo, una familia existente de cualquier tamaño puede mudarse aquí si está siendo reubicada."; }
		
		{ String _name = "Smalltownhouse";					String _text = "Casa Adosada"; }
		{ String _name = "SmalltownhouseLwr";				String _text = "casa adosada"; }
		{ String _name = "SmalltownhouseTip";				String _text = "Una Casa Adosada es un hogar cálido y cómodo para una familia de 5."; }
		
		{ String _name = "SmalltownhouseC";					String _text = "Casa Adosada Bonita"; }
		{ String _name = "SmalltownhouseCLwr";				String _text = "casa adosada bonita"; }
		{ String _name = "SmalltownhouseCTip";				String _text = "Una Casa Adosada Bonita es un hogar aún más cálido y cómodo para una familia de 6."; }
		
		{ String _name = "SmalltownhouseD";					String _text = "Casa Adosada Lujosa"; }
		{ String _name = "SmalltownhouseDLwr";				String _text = "casa adosada lujosa"; }
		{ String _name = "SmalltownhouseDTip";				String _text = "Una Casa Adosada Lujosa es el hogar más cálido y cómodo para una familia de 6."; }

		{ String _name = "Twarehouse";						String _text = "Almacén Seco"; }
		{ String _name = "TwarehouseLwr";					String _text = "almacén seco"; }
		{ String _name = "TwarehouseTip";					String _text = "El edificio de Almacén Seco guarda textiles, como algodón, lino, cuero, lana, tela, hilo de lino y hoja de tabaco."; }		

		{ String _name = "Oilpress";						String _text = "Prensa de Aceite"; }
		{ String _name = "OilpressLwr";						String _text = "prensa de aceite"; }
		{ String _name = "OilpressTip";						String _text = "Una Prensa de Aceite extrae aceite de aceitunas y de semillas cosechadas de girasol, lino y algodón, además de grasa de ballena."; }

		{ String _name = "Weavers";							String _text = "Tejedores"; }
		{ String _name = "WeaversLwr";						String _text = "tejedores"; }
		{ String _name = "WeaversTip";						String _text = "Un Tejedor fabrica hilo de lino, tela y seda a partir de lino, algodón y capullos de gusano de seda."; }

		{ String _name = "Clothier";						String _text = "Modista"; }
		{ String _name = "ClothierLwr";						String _text = "modista"; }
		{ String _name = "ClothierTip";						String _text = "Una Modista es un Sastre mejorado que fabrica ropa de mayor calidad, más cálida y de mayor valor comercial."; }

		{ String _name = "Silkwormhut";					String _text = "Choza de Gusanos de Seda"; }
		{ String _name = "SilkwormhutLwr";				String _text = "choza de gusanos de seda"; }
		{ String _name = "SilkwormhutTip";				String _text = "Una Choza de Gusanos de Seda cría gusanos de seda para obtener seda y, como último recurso, alimento. Los gusanos de seda necesitan hojas de mora blanca como alimento. Estas se pueden comerciar u obtener de un huerto."; }

		{ String _name = "Tobaccobarn";					String _text = "Granero de Curado"; }
		{ String _name = "TobaccobarnLwr";				String _text = "granero de curado"; }
		{ String _name = "TobaccobarnTip";				String _text = "Aquí es donde el tabaco se cura al aire para convertirse en tabaco de pipa para fumar. Los productos terminados deben almacenarse en un edificio de Posada y Jardín"; }

		{ String _name = "CCStatue1";					String _text = "Estatua del Fuero"; }
		{ String _name = "CCStatue1Lwr";				String _text = "estatua del fuero"; }
		{ String _name = "CCStatue1Tip";				String _text = "Una estatua que representa al gobernador de la colonia."; }
		{ String _name = "Quote1";						String _text = "Podría ser que el propósito de tu vida sea solo servir de advertencia para otros."; }

		{ String _name = "CCStatue2";					String _text = "Estatua del Fuero"; }
		{ String _name = "CCStatue2Lwr";				String _text = "estatua del fuero"; }
		{ String _name = "CCStatue2Tip";				String _text = "Una estatua que representa al gobernador de la colonia montado en una llama."; }
		{ String _name = "Quote2";						String _text = "El secreto más oscuro de esta colonia es que demasiados de sus ciudadanos todavía imaginan que pertenecen a una civilización muy superior en otro lugar."; }
		
		{ String _name = "Roadtriangle";				String _text = "Plaza de Piedra Triangular"; }
		{ String _name = "RoadtriangleLwr";				String _text = "plaza de piedra triangular"; }
		{ String _name = "RoadtriangleTip";				String _text = "Para nivelar y decorar zonas con plazas estéticas, las piezas triangulares encajan bien en las esquinas."; }
		
		{ String _name = "Roadstraight";				String _text = "Plaza de Piedra Recta"; }
		{ String _name = "RoadstraightLwr";				String _text = "plaza de piedra recta"; }
