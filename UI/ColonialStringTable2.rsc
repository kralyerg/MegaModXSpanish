		{ String _name = "CCcustom1Name";					String _text = "Colonial Charter"; }
		{ String _name = "CCcustom1Desc";					String _text = "La descripción de Colonial Charter va aquí"; }

		{ String _name = "CCAdamEve";						String _text = "[CC] Adán y Eva"; }
		{ String _name = "CCAdamEveDesc";					String _text = "Empieza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en un pequeño carro de almacenamiento. No se ha construido ninguna estructura, no hay herramientas, semillas ni ganado disponibles al principio - tendrás que sobrevivir y conseguirlo todo."; }

		{ String _name = "CCSilkRoad";						String _text = "[CC] Ruta de la Seda - Fácil"; }
		{ String _name = "CCSilkRoadDesc";					String _text = "Empieza con la capacidad de alimentar y cosechar gusanos de seda para obtener su preciada seda. Comienza con seis familias. Se proporciona una gran cantidad de ropa, comida, leña, materiales de construcción y herramientas. Las viviendas y zonas de almacenamiento ya están construidas."; }
		
		{ String _name = "CCSilkRoadMed";					String _text = "[CC] Ruta de la Seda - Media"; }
		{ String _name = "CCSilkRoadMedDesc";					String _text = "Empieza con la capacidad de alimentar y cosechar gusanos de seda para obtener su preciada seda. Comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento."; }
		
		{ String _name = "CCMine";							String _text = "[CC] Mina"; }
		{ String _name = "CCMineDesc";						String _text = "Minería única para objetos valiosos."; }

		{ String _name = "CCMediumPlus";					String _text = "[CC] Media+"; }
		{ String _name = "CCMediumPlusDesc";					String _text = "Añade ganado. Una partida media+ comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento. También hay disponibles algunas semillas para campos y huertos, así como una manada de ganado."; }
		
		{ String _name = "CCMissionary";					String _text = "[CC] Misionero"; }
		{ String _name = "CCMissionaryDesc";					String _text = "Una partida de misionero comienza con una Casa Parroquial y tres familias, 2 de ellas sin educación. Ya hay 2 casas construidas y se proporcionan algunos suministros básicos. Hay disponible un carro de almacenamiento. También hay disponibles algunas semillas para campos y huertos, así como una manada de ganado."; }

