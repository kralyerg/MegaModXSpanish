		{ String _name = "CorduroyRoadLwr";				String _text = "camino de troncos"; }
		{ String _name = "CorduroyRoadTip";				String _text = "Camino hecho de madera."; }

		{ String _name = "BackAlley";					String _text = "Callejón"; }
		{ String _name = "BackAlleyLwr";				String _text = "callejón"; }
		{ String _name = "BackAlleyTip";				String _text = "Un callejón donde se pueden cerrar tratos y satisfacer ciertas necesidades. Proporciona todo tipo de artículos de contrabando."; }

		{ String _name = "Winery";						String _text = "Bodega"; }
		{ String _name = "WineryLwr";					String _text = "bodega"; }
		{ String _name = "WineryTip";					String _text = "Una Bodega elabora vino a partir de uvas y otras frutas. El vino producido debe almacenarse en un edificio de Posada y Jardín."; }

		{ String _name = "Apiary";						String _text = "Apiario"; }
		{ String _name = "ApiaryLwr";					String _text = "apiario"; }
		{ String _name = "ApiaryTip";					String _text = "Un Apiario produce miel como alimento o cera de abeja, que puede convertirse en velas en una Cerería."; }

