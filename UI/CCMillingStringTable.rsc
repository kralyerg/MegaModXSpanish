		{ String _name = "cc17Windmill";				String _text = "Molino de Viento de Ciudad"; }
		{ String _name = "cc17WindmillLwr";				String _text = "molino de viento de ciudad"; }
		{ String _name = "cc17WindmillTip";				String _text = "El Molino de Viento de Ciudad es un edificio grande capaz de fabricar Harina a partir de varios tipos de grano. Es el molino de viento más rápido y eficiente disponible."; }

		{ String _name = "Watermill";					String _text = "Molino de Agua"; }
		{ String _name = "WatermillLwr";				String _text = "molino de agua"; }
		{ String _name = "WatermillTip";				String _text = "Un Molino de Agua fabrica harina a partir de grano y debe construirse en una orilla. La harina no es comestible y puede llevarse a una panadería para prepararla como alimento o comerciarse. Pulsa F para cambiar su apariencia."; }

		{ String _name = "Windmill";					String _text = "Molino de Viento Grande"; }
		{ String _name = "WindmillLwr";					String _text = "molino de viento grande"; }
		{ String _name = "WindmillTip";					String _text = "Un Molino de Viento Grande fabrica harina a partir de grano. La harina no es comestible y puede llevarse a una panadería para prepararla como alimento o comerciarse."; }

		{ String _name = "StoneWindmill";				String _text = "Molino de Viento Pequeño"; }
		{ String _name = "StoneWindmillLwr";			String _text = "molino de viento pequeño"; }
		{ String _name = "StoneWindmillTip";			String _text = "Un Molino de Viento Pequeño fabrica harina a partir de grano. La harina no es comestible y puede llevarse a una panadería para prepararla como alimento o comerciarse. Este molino produce harina más lentamente que el Molino de Viento Grande."; }


		{ String _name = "ProfessionMiller";			String _text = "Molinero"; }
		{ String _name = "ProfessionMillerTip";			String _text = "El molinero opera el molino y muele el grano hasta convertirlo en harina."; }
		{ String _name = "ProfessionMillerDeath";		String _text = "murió aplastado por la rueda hidráulica mientras molía."; }

		{ String _name = "WindmillItemsTip";					String _text = "Molinos de Viento y Molinos de Agua"; }


