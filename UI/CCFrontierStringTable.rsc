		{ String _name = "QuartermasterTip";			String _text = "El Intendente es la primera y más importante pieza que debes construir al establecer una presencia militar en una nueva zona. Cuando está ocupado, los Suministros Militares serán traídos en un flujo constante por agentes de tu Armada."; }
		
