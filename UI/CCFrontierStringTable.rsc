StringTable resource
{
	Entry _strings
	[ 


	// #########################################
	// ##          Starting Settings          ##
	// #########################################

		{ String _name = "CCAdamEve";			String _text = "[CC] Adán y Eva"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Comienza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en una carreta de almacenamiento pequeña. No se ha construido ninguna estructura, no hay semillas ni ganado disponibles inicialmente - tendrás que sobrevivir y conseguirlo todo."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Misionero"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Una partida Misionera comienza con una Casa Parroquial y tres familias, 2 de ellas incultas. Ya hay 2 casas construidas y se proporcionan algunos suministros basicos. Hay disponible una carreta de almacenamiento. Hay disponibles algunas semillas para campos y huertos, así como un rebaño de ganado."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Nueva Frontera"; }
		{ String _name = "CCFortDesc";			String _text = "La Nueva Frontera te inicia en un puesto fronterizo junto a un pueblo nativo americano amistoso. Defiende y cuida a tus ciudadanos y tu leyenda se contará en el oeste por siempre. Esta partida comienza con 3 familias y ya se ha construido un pequeño fuerte con algunos suministros. Incluye la opción de descubrir tesoros en un terreno ceremonial."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Pueblo Nativo - Difícil"; }
		{ String _name = "CCFortHardDesc";		String _text = "El inicio de Pueblo Nativo requiere que tengas buenas relaciones con la tribu nativa de la zona y es un comienzo bastante difícil. El pueblo requerirá recursos (mejoras) para señalar tu amistad y luego podrás elegir cómo quieres interactuar con los edificios. Como extranjeros en esta tierra teneis mucho que aprender y ganar buscando aliados en lugar de enemigos."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Pueblo Nativo - Adán y Eva"; }
		{ String _name = "CCFortAEDesc";		String _text = "Comienza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en una carreta de almacenamiento pequeña. El inicio de Pueblo Nativo requiere que tengas buenas relaciones con la tribu nativa de la zona y es un comienzo bastante difícil. El pueblo requerirá recursos (mejoras) para señalar tu amistad y luego podrás elegir cómo quieres interactuar con los edificios. Como extranjeros en esta tierra teneis mucho que aprender y ganar buscando aliados en lugar de enemigos."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] La Maldición de la Llama Dorada - Fácil"; }
		{ String _name = "LlamaEasyDesc";		String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de banished. ¿Que es la Llama Dorada? ¿Que misterios guarda? ¿Te atreves a explorar su turbio interior? Esta es una partida que comienza según los ajustes normales de Fácil, pero incluye la opción de aventurarse en busca de tesoros. "; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] La Maldición de la Llama Dorada - Media"; }
		{ String _name = "LlamaMediumDesc";		String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de banished. ¿Que es la Llama Dorada? ¿Que misterios guarda? ¿Te atreves a explorar su turbio interior? Esta es una partida que comienza según los ajustes normales de Media, pero incluye la opción de aventurarse en busca de tesoros."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] La Maldición de la Llama Dorada - Difícil"; }
		{ String _name = "LlamaHardDesc";		String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de banished. ¿Que es la Llama Dorada? ¿Que misterios guarda? ¿Te atreves a explorar su turbio interior? Esta es una partida que comienza según los ajustes normales de Difícil, pero incluye la opción de aventurarse en busca de tesoros. "; }

		{ String _name = "LlamaAEName";			String _text = "[CC] La Maldición de la Llama Dorada - Adán y Eva"; }
		{ String _name = "LlamaAEDesc";			String _text = "La Maldición de la Llama Dorada es lo más parecido a un misterio en el mundo de banished. ¿Que es la Llama Dorada? ¿Que misterios guarda? ¿Te atreves a explorar su turbio interior? Esta es una partida que comienza según los ajustes de Adán y Eva, pero incluye la opción de aventurarse en busca de tesoros. "; }


