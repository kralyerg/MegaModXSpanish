		{ String _name = "WorkcampTip";				String _text = "El ejército no es solo guerra - la construcción y el desarrollo del paisaje siempre han sido responsabilidad de las fuerzas militares en tiempos de paz. Este campamento de trabajo convierte el pago básico, las herramientas y la energía de la guarnición inquieta en recursos basicos."; }
		{ String _name = "WorkcampBoxTip";			String _text = "Requiere: Penique y Herramientas de Hierro.  Produce: Surtido aleatorio de Leña, Piedra, Hierro, Carbón."; }
		
		{ String _name = "Stitcher";				String _text = "Fabricante de Uniformes"; }
		{ String _name = "StitcherLwr";				String _text = "fabricante de uniformes"; }
		{ String _name = "StitcherTip";				String _text = "El Fabricante de Uniformes es un especialista militar centrado en la producción de orgullosos uniformes militares. Estos uniformes son esenciales para la moral de los soldados en batalla y son un componente importante de tu fuerza militar. Solo fabrica Uniformes."; }
		
		{ String _name = "Quartermaster";			String _text = "Intendente"; }
