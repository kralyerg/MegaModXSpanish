		{ String _name = "FlattenCC";					String _text = "Aplanar Terreno"; }
		{ String _name = "FlattenCCTip";				String _text = "Aplana el terreno. El agua y los agujeros suben, las montañas bajan. Usa la herramienta de eliminar estructuras para borrar iconos amarillos despues de aplanar el terreno. Usa esta herramienta con mucho cuidado ya que no puedes deshacer tus acciones."; }

		{ String _name = "PlankBridge";					String _text = "Puente de Tablones de Arroyo"; }
		{ String _name = "PlankBridgeLwr";				String _text = "puente de tablones de arroyo"; }
		{ String _name = "PlankBridgeTip";				String _text = "Un pequeño puente de arroyo hecho de madera. Este puente está disenado para arroyos pequeños, no para grandes rios, pero funcionará con ambos."; }

		{ String _name = "RockBridge";					String _text = "Puente de Roca"; }
