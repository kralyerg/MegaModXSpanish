		{ String _name = "Forwardpost";				String _text = "Puesto Avanzado"; }
		{ String _name = "ForwardpostLwr";			String _text = "puesto avanzado"; }
		{ String _name = "ForwardpostTip";			String _text = "Este puesto representa una de las incursiones de tu fuerza militar en territorio enemigo. La guerra exitosa en esta era requiere armas y uniformes coloridos y orgullosos, pero a medida que venzas a tus enemigos el puesto generará muchos objetos útiles para tu colonia - incluyendo varios suministros de construcción lucrativos, artefactos valiosos, o bienes comerciales raros capturados a los derrotados."; }
		{ String _name = "ForwardpostBoxTip";			String _text = "Requiere: Suministro Militar.  Produce: Surtido aleatorio de Vino, Licor, Mosquete, Cañón, Cerámica, Gemas, Abrigo de Cuero, Artefacto Nativo."; }

		{ String _name = "MusketRange";				String _text = "Campo de Tiro de Mosquetes"; }
		{ String _name = "MusketRangeLwr";			String _text = "campo de tiro de mosquetes"; }
		{ String _name = "MusketRangeTip";			String _text = "Aquí es donde los soldados de tu colonia entrenan para ser los mejores y estar más preparados para lo que este mundo les depare. Durante el entrenamiento necesario, se producirán recursos vitales para la supervivencia de tu colonia (como herramientas y ropa)."; }
		{ String _name = "MusketRangeBoxTip";			String _text = "Requiere: Penique. Produce: Surtido aleatorio de Herramienta de Acero, Mosquete, Uniforme, Cerveza, Tabaco de Pipa."; }

