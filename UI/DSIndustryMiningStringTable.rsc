		{
			String _name = "DSCoalBellPit1";
			String _text = "Pozo de Campana de Carbón";
		}
		{
			String _name = "DSCoalBellPit1Lwr";
			String _text = "pozo de campana de carbón";
		}
		{
			String _name = "DSCoalBellPit1Tip";
			String _text = "Una mina de Carbón primitiva, construida en terreno llano, requiere 3-8 mineros que extraerán solo Carbón de un pozo con forma de 'campana' en el suelo. Tiene una producción limitada de 600 y deberá mejorarse una vez agotada para seguir funcionando. Requiere 34 de trabajo para construir.";
		}
		{
			String _name = "DSCoalBellPit1Upgrade";
			String _text = "Mina del Pozo de Campana de Carbón";
		}
		{
			String _name = "DSCoalBellPit1UpgradeLwr";
			String _text = "mina del pozo de campana de carbón";
		}
		{
			String _name = "DSCoalBellPit1UpgradeTip";
			String _text = "Mejora el pozo de campana para permitir una producción adicional de 5400, y una extracción de Carbón ligeramente más rápida con la adición de un sistema de poleas para ayudar a los mineros (hasta 13 mineros). Requiere 89 de trabajo para mejorar.";
		}
		{
			String _name = "DSSmallIronOreMine";
