		}
		{
			String _name = "DSSmallIronOreMineLwr";
			String _text = "pequeña mina de mineral de hierro";
		}
		{
			String _name = "DSSmallIronOreMineTip";
			String _text = "Una pequeña mina de montaña que emplea a 1-13 mineros que extraerán solo Mineral de Hierro. Tiene una producción limitada de 1200, pero se puede mejorar para seguir funcionando. Requiere 21 de trabajo para construir la entrada de la mina. Una mina barata, pero para obtener la máxima producción, la mina debe colocarse en una ubicación ideal *puede ser difícil de colocar, persevera.";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLamps";
