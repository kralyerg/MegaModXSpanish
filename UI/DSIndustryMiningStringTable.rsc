		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsLwr";
			String _text = "mina de mineral de hierro";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsTip";
			String _text = "Mejora para permitir una vida útil más larga de 24 800, y una extracción de Mineral de Hierro ligeramente más rápida, pudiendo emplear hasta 21 mineros. Requiere 89 de trabajo para mejorar";
		}
