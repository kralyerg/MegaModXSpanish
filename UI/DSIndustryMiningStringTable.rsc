		}
		{
			String _name = "ImprovedMineTip";
			String _text = "El modelo de Mina Mejorada, elaborado en colaboración con Yandersen. Esta es una mina de montaña que emplea a 1-30 mineros que extraerán: Mineral de Hierro, Mineral de Cobre o Carbón. Tiene una producción limitada de 21 000. Requiere 144 de trabajo para construir.";
		}
		{
			String _name = "DSThaddSurrelMineOilLamps";
			String _text = "Thadd Surrel y familia: Mina Industrial";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsLwr";
			String _text = "mina industrial";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsTip";
			String _text = "La Mina industrial de Thadd Surrel y familia. Capaz de extraer Mineral de Hierro, Mineral de Cobre, Mineral de Estaño o Carbón, requiere Madera y Aceite para Lámparas o Velas para funcionar. Emplea a 1-55 mineros. La mina tiene una gran producción de 250 000 a lo largo de su vida. Requiere 233 de trabajo para construir.";
		}
		{
			String _name = "DSIndustryMineSecond";
			String _text = "Thadd Surrel y familia: 2ª Mina Industrial";
		}
		{
			String _name = "DSIndustryMineSecondLwr";
			String _text = "segunda mina industrial";
		}
		{
			String _name = "DSIndustryMineSecondTip";
			String _text = "La segunda gran Mina industrial de Thadd Surrel y familia. Capaz de extraer Mineral de Hierro, Mineral de Cobre, Mineral de Estaño o Carbón, requiere Madera y Aceite para Lámparas o Velas para funcionar. Emplea a 1-72 mineros. La mina tiene una producción casi vitalicia de 5 000 000 a lo largo de su vida. Requiere 512 de trabajo para construir.";
		}
		{
			String _name = "DSClarenceSilverMine01";
			String _text = "Mina de Plata Clarence, 1ª estrella";
		}
		{
			String _name = "DSClarenceSilverMine01Lwr";
			String _text = "mina de plata clarence";
		}
		{
			String _name = "DSClarenceSilverMine01Tip";
			String _text = "La Mina de Plata Clarence, una gran mina de Mineral de Plata; en su primera construcción, de nivel 1ª estrella, la mina emplea a 1-8 mineros y requerirá Madera y 2 de Aceite para Lámparas para funcionar. La mina tiene una producción limitada antes de necesitar una mejora para seguir extrayendo mineral de plata. Requiere 89 de trabajo para construir.";
		}
		{
			String _name = "DSClarenceSilverMine02";
			String _text = "Mina de Plata Clarence, 2ª estrella";
		}
		{
			String _name = "DSClarenceSilverMine02Lwr";
			String _text = "mina de plata clarence";
		}
		{
			String _name = "DSClarenceSilverMine02Tip";
			String _text = "Mejora la mina, ampliando la sala de clasificación trasera para dar paso a una entrada de mina más grande. Los túneles existentes se reforzarán para soportar una plantilla minera ligeramente mayor de 13 mineros. La mina mejorada tendrá una producción total de 610 antes de necesitar otra mejora. Requiere 144 de trabajo para construir.";
		}
		{
			String _name = "DSClarenceSilverMine03";
			String _text = "Mina de Plata Clarence, 3ª estrella";
		}
		{
			String _name = "DSClarenceSilverMine03Lwr";
			String _text = "mina de plata clarence";
		}
		{
			String _name = "DSClarenceSilverMine03Tip";
			String _text = "Al mejorar la mina, añadirás un gran sistema de poleas aéreas, que permitirá una mina más profunda y una extracción más rápida, ya que las poleas facilitan el transporte de los pesados minerales hasta la superficie. La mina puede contratar hasta 21 mineros. La mina mejorada tendrá una producción total de 1597 antes de necesitar otra mejora. Requiere 233 de trabajo para construir.";
		}
		{
			String _name = "DSClarenceSilverMine04";
			String _text = "Mina de Plata Clarence, 4ª estrella";
		}
		{
			String _name = "DSClarenceSilverMine04Lwr";
			String _text = "mina de plata clarence";
		}
		{
			String _name = "DSClarenceSilverMine04Tip";
			String _text = "Mejora y perfecciona aún más el sistema de poleas añadiendo otra polea. Una extracción de nuevo más rápida, y ahora la mina puede emplear hasta 34 mineros. Pero eso no es todo, la iluminación de la mina también se mejora, y el rendimiento de la producción aumenta, ya que los mineros ahora solo requieren 1 de Aceite para Lámparas. La mina mejorada tendrá una producción total de 4181 antes de necesitar otra mejora. Requiere 377 de trabajo para construir.";
		}
		{
			String _name = "DSClarenceSilverMine05";
			String _text = "Mina de Plata Clarence, 5ª estrella";
		}
		{
			String _name = "DSClarenceSilverMine05Lwr";
			String _text = "mina de plata clarence";
		}
		{
			String _name = "DSClarenceSilverMine05Tip";
			String _text = "Al mejorar la mina, la instalación de vías férreas permitirá el uso de vagonetas más rápidas, aumentando la tasa de producción. Esta es la profundidad final de la mina, tras la cual quedará agotada de todo el Mineral de Plata. Tiene una capacidad total de 10 946. Requiere 610 de trabajo para construir.";
		}
		{
			String _name = "UpgradeClarenceSilverMine01Txt";
