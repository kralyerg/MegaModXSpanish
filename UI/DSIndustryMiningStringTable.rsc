StringTable startConditions
{
	Entry _strings
	[
		{
			String _name = "Easy0Name";
			String _text = "Industria: Herramientas";
		}
		{
			String _name = "Easy0Desc";
			String _text = "Una partida fácil, comienza con cinco familias y hogares. Se proporciona una gran cantidad de ropa, comida, leña, carbón vegetal, herramientas, troncos, hierro y piedra. Los graneros de almacenamiento de Thadd Surrel ya están construidos, así como la Herrería de Thadd Surrel, y el Hogar de Herrero y la Piedra de Afilar. También hay disponibles algunas semillas para campos y huertos, así como un rebaño de ganado.";
		}
		{
			String _name = "Easy2Name";
			String _text = "Industria: Lino, Hilo de Lino y Aceite de Lámpara";
		}
		{
			String _name = "Easy2Desc";
			String _text = "Una partida fácil, comienza con cinco familias y hogares. Se proporciona una gran cantidad de ropa, comida, leña, carbón vegetal, herramientas, troncos, hierro y piedra. Los graneros de almacenamiento de Thadd Surrel ya están construidos, así como el Tejedor de Lino, el Horno de Aceite y el Cobertizo de Prensado de Thadd Surrel. Hay disponibles semillas de lino para el campo y una semilla de huerto, así como un rebaño de ganado.";
		}
		{
			String _name = "Medium0Name";
			String _text = "Industria: almacenamiento de Thadd Surrel";
		}
		{
			String _name = "Medium0Desc";
			String _text = "Una partida media, comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas, y algo de troncos, hierro y piedra. Los graneros de almacenamiento de Thadd Surrel ya están construidos. Hay disponibles algunas semillas para campos y huertos.";
		}
		{
			String _name = "Hard0Name";
			String _text = "Industria: carboneros";
		}
		{
			String _name = "Hard0Desc";
			String _text = "Una partida difícil, comienza con cuatro familias. Se proporciona algo de ropa, comida, herramientas, piedra, y una gran cantidad de troncos. Tienes algunos barriles y cajas de almacenamiento que guardan tus bienes, así como dos Pilas de Carbón vegetal ya construidas.";
		}
		{
			String _name = "Hard1Name";
			String _text = "Industria: fundidores de mena";
		}
		{
			String _name = "Hard1Desc";
			String _text = "Una partida difícil, comienza con cuatro familias. Se proporciona algo de ropa, comida, herramientas, piedra, carbón vegetal y troncos. Tienes algunos barriles y cajas de almacenamiento que guardan tus bienes, así como dos Fundiciones de Cuba (cobre y hierro) y una pequeña Pila de Carbón vegetal ya construidas.";
		}
	]

}
