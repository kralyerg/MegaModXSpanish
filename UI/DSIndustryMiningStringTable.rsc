		}
		{
			String _name = "DSIndustryWoodChopperTip";
			String _text = "Se emplea a 1 leñador para cortar troncos o madera y convertirlos en Leña. Requiere 8 de trabajo para construir.";
		}
		{
			String _name = "DSThaddSurrelLumbermill";
			String _text = "Thadd Surrel y familia: Aserradero";
		}
		{
			String _name = "DSThaddSurrelLumbermillLwr";
			String _text = "aserradero industrial";
		}
		{
			String _name = "DSThaddSurrelLumbermillTip";
			String _text = "El Aserradero de Thadd Surrel y familia; 1-5 leñadores operarán el aserradero, procesando Troncos en Madera o Leña. Requiere 144 de trabajo para construir.";
		}
		{
			String _name = "DSWaterPowerFurnace";
			String _text = "Alto Horno Hidráulico";
		}
		{
			String _name = "DSWaterPowerFurnaceLwr";
			String _text = "alto horno";
		}
		{
			String _name = "DSWaterPowerFurnaceTip";
			String _text = "Requiere construirse junto a un arroyo o río; usando altas temperaturas y un gran flujo de aire, este alto horno es la adición perfecta a un asentamiento industrial. La energía hidráulica se usa para operar grandes fuelles, forzando la entrada de aire al horno. Es capaz de procesar grandes cantidades de Mineral de Hierro en Hierro, Mineral de Cobre en Cobre, Mineral de Estaño en Estaño, o Minerales de Cobre y Estaño en Bronce, con la ayuda de un combustible metalúrgico (coque o carbón vegetal). Emplea a 1-8 herreros. La construcción del edificio requiere 233 de trabajo.";
		}
		{
			String _name = "DSBlastFurnace";
			String _text = "Thadd Surrel y familia: Alto Horno";
		}
		{
			String _name = "DSBlastFurnaceLwr";
			String _text = "alto horno";
		}
		{
			String _name = "DSBlastFurnaceTip";
			String _text = "Puede construirse en terreno llano; este alto horno es capaz de alcanzar altas temperaturas gracias a la inclusión de una máquina de vapor con caldera de cobre para operar los fuelles. Este horno es la adición perfecta a un asentamiento industrial. Es capaz de procesar grandes cantidades de Mineral de Hierro en Hierro, Mineral de Cobre en Cobre, Mineral de Estaño en Estaño, o Minerales de Cobre y Estaño en Bronce, con la ayuda de un combustible metalúrgico (coque o carbón vegetal). Emplea a 1-6 herreros. La construcción del edificio requiere 233 de trabajo. Variantes con la tecla F.";
		}
		{
			String _name = "DSHillLimeKiln";
			String _text = "Horno de Cal de Colina";
		}
		{
			String _name = "DSHillLimeKilnLwr";
			String _text = "horno de cal de colina";
		}
		{
			String _name = "DSHillLimeKilnTip";
			String _text = "El Horno de Cal de Colina tomará Piedra y producirá Cal (también conocida como cal viva). La Cal se puede usar en el proceso de fabricar Hierro, y también se usa como material de construcción (mortero y revoco). Requiere 89 de trabajo para construir. Debe construirse adosado a una colina o montaña.";
		}
