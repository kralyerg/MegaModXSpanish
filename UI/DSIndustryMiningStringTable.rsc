		}
		{
			String _name = "DSPlacerMine01Tip";
			String _text = "Una mina de placer extraerá Mineral de Estaño y Oro de un terraplén de un curso de agua. Emplea a 1-4 mineros. La mina tiene una larga producción de por vida de 13 000 a lo largo de su vida. Requiere 84 de trabajo para construir.";
		}
		{
