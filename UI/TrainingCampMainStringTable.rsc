		{ String _name = "RKMChousetentstoolbarTip";			String _text = "Abre la barra 'Viviendas de Tienda del Campamento de Entrenamiento' para ver las opciones."; }

		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Ustedes son los arcos desde los cuales sus hijos son lanzados como flechas vivientes. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Cada nacion tiene una bandera. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "El ataque es el secreto de la defensa; la defensa es la planificacion de un ataque. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "No creo que la arquitectura trate solo de refugio, de un simple recinto. Deberia poder emocionarte, calmarte, hacerte pensar. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "La raza humana tiene un arma realmente eficaz, y esa es la risa. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "El arma mas poderosa en la tierra es el alma humana en llamas. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "La no violencia es un arma poderosa y justa. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Una vida bien ordenada es como subir una torre; la vista a mitad de camino es mejor que la vista desde la base, y mejora constantemente a medida que el horizonte se expande. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "No puedo mostrarte exactamente como la salud es un derecho humano básico. Pero lo que si puedo argumentar es que nadie deberia morir de una enfermedad que es tratable. - Paul Farmer."; }

