StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "La quema de carbón vegetal la inician los Peones del pueblo; despejarán todo el área y luego entregarán los Troncos en el lugar.";
		}
		{
			String _name = "text2";
			String _text = "Después, un Constructor preparará y colocará los Troncos en una gran pila de madera, cubrirá todo con algo de tierra, y antes de cerrarla por completo, encenderá la pila.";
		}
		{
			String _name = "text3";
			String _text = "Una vez que el proceso de carbonización se complete, un carbonero";
		}
		{
			String _name = "text4";
			String _text = "se asegurará de que la pila esté apagada y extraerá el Carbón vegetal.";
		}
		{
			String _name = "text5";
			String _text = "Las Pilas de Carbón vegetal son peligrosas, malolientes y humeantes. Son más adecuadas fuera de los pueblos, dentro de los bosques o lejos de otros edificios.";
		}
		{
			String _name = "CharcoalRequire";
			String _text = "Carbón vegetal - Combustible Metalúrgico, pero también usado en algunos hogares. Cuando se usa en herrería es capaz de arder a las temperaturas muy altas necesarias para fundir metales sólidos.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Pulsa para demoler y comenzar a limpiar el lugar.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "La pila de carbón vegetal ha expirado; el trabajo de limpieza del lugar ya ha comenzado. Una vez que esto se complete podrás retirar la ceniza sobrante no deseada.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Detén la retirada del recurso y detén la destrucción de esta pila de carbón vegetal.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Retirar";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Ahora que por fin estás listo para retirar y limpiar después de la pila de carbón vegetal:";
		}
		{
			String _name = "text6";
			String _text = "¡Vaya! los constructores han dejado atrás la ceniza gastada de la pila de carbón vegetal, pulsa el botón para retirarla.";
		}
	]

}
