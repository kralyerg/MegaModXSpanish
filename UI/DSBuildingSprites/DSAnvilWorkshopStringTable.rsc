		}
		{
			String _name = "DSAnvilWorkshopTip";
			String _text = "un pequeño taller del yunque para la producción de Herramientas de Cobre, Bronce y Hierro, Piezas de Carreta, y Equipo de Pesca y Caza. Emplea 1 herrero.";
		}
