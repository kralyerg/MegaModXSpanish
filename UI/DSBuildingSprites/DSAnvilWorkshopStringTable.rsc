		}
		{
			String _name = "DSGrindstoneWorkshopTip";
			String _text = "un pequeño anexo a la herrería y fabricación de herramientas, la piedra de afilar empleará a 1 herrero que tomará Herramientas y las afilará para crear una versión (fina) de sí mismas, estas son versiones más duraderas, denotadas con un *asterisco después de su nombre.";
		}
		{
			String _name = "EnableGrindstoneWork";
			String _text = "Afilando herramientas en la piedra de afilar";
		}
		{
			String _name = "GrindstoneProductTip";
			String _text = "Selecciona un tipo de herramienta para afilar, una vez afiladas se devolverán al almacén y estas herramientas más afiladas y de mayor calidad (añaden 25 puntos de trabajo a las herramientas) se denotarán con un asterisco (*) después de su nombre. Alternativamente, si se procesan con Aceite de Linaza, las herramientas mejorarán en 50 puntos de trabajo, y se denotarán con un asterisco y un circunflejo (*^) después de su nombre.";
		}
