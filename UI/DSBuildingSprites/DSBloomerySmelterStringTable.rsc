StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "La fundición en la fundición de cuba la inician los Peones del pueblo, quienes despejarán todo el área y luego entregarán las menas, el carbón vegetal y la arcilla en el lugar.";
		}
		{
			String _name = "text2";
			String _text = "Después, un Constructor levantará la fundición de cuba con la arcilla. En la fundición añadirán mena y carbón vegetal en capas alternadas. La fundición se enciende ya en las primeras etapas mientras se añaden las capas; los constructores realizarán la mayor parte del trabajo, perforando un agujero para dejar escapar la escoria no deseada, y al terminar, comenzarán a demolerla.";
		}
		{
			String _name = "text3";
			String _text = "Una vez terminado esto, un herrero extraerá la esponja de hierro";
		}
		{
			String _name = "text4";
			String _text = "de la fundición, y la trabajará para crear el producto terminado.";
		}
		{
			String _name = "text5";
			String _text = "Una Fundición de Cuba deberá demolerse una vez que el herrero haya terminado de procesar el Hierro.";
		}
		{
			String _name = "text5copper";
			String _text = "Una Fundición de Cuba deberá demolerse una vez que el herrero haya terminado de procesar el Cobre.";
		}
		{
			String _name = "IronRequire";
			String _text = "Hierro - el más común y utilizado de los metales; el Hierro tiene su propio límite para controlar la producción. Usado de forma importante como material para producir Herramientas, también se utiliza en la construcción de edificios.";
		}
		{
			String _name = "CopperRequire";
			String _text = "Cobre - producido bajo el límite de Metales, Aleaciones y Forjados para controlar la producción. Sus usos son sobre todo en la construcción de edificios, aunque también puede usarse para fabricar Herramientas y objetos de cobre.";
		}
		{
			String _name = "BronzeRequire";
			String _text = "Bronce - producido bajo el límite de Metales, Aleaciones y Forjados para controlar la producción. Usado como producto temprano para fabricar Herramientas, también se utiliza en la construcción.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Pulsa para demoler y comenzar a limpiar el lugar.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "La fundición de cuba ha expirado; el trabajo de limpieza del lugar ya ha comenzado. Una vez que esto se complete podrás retirar la antigua base de la fundición.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Detén la retirada del recurso y detén la destrucción de esta fundición de cuba.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Retirar";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Ahora que por fin estás listo para retirar y limpiar después de la fundición de cuba:";
		}
		{
			String _name = "text6";
			String _text = "¡Vaya! los constructores han dejado atrás la base de la fundición de cuba agotada, pulsa el botón para retirarla.";
		}
	]

}
