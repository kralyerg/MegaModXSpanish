	// ------------ New Egypt Starting Conditions ---------------------------
		{ String _name = "EgyptEasyName";		String _text = "Egipto - Fácil"; }
		{ String _name = "EgyptEasyDesc";		String _text = "Una partida estándar Fácil con solo palmeras. Una partida fácil comienza con seis familias. Se proporciona una gran cantidad de ropa, comida, leña, materiales de construcción y herramientas. Las viviendas y las zonas de almacenamiento ya están construidas. Hay semillas disponibles para campos y huertos, así como un rebaño de ganado."; }

		{ String _name = "EgyptMediumName";		String _text = "Egipto - Media"; }
		{ String _name = "EgyptMediumDesc";		String _text = "Una partida estándar Media con solo palmeras. Una partida media comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento. Hay disponibles algunas semillas para campos y huertos."; }

		{ String _name = "EgyptHardName";		String _text = "Egipto - Difícil"; }
		{ String _name = "EgyptHardDesc";		String _text = "Una partida estándar Difícil con solo palmeras. Una partida difícil comienza con cuatro familias. Se proporciona una pequeña cantidad de ropa, comida, leña y herramientas. No hay semillas disponibles para la agricultura."; }

		{ String _name = "EgyptAEName";			String _text = "Egipto - Adán y Eva"; }
		{ String _name = "EgyptAEDesc";			String _text = "Una partida estándar de Adán y Eva con solo palmeras. Comienza con tan solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en un pequeño carro de almacenamiento. No se ha construido ninguna estructura, no hay semillas ni ganado disponibles al principio: tendrás que sobrevivir y conseguirlo todo."; }

