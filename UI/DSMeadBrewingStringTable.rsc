			String _text = "cervecero de hidromiel de la plaza del pueblo";
		}
		{
			String _name = "DSVillageSquareMeadBrewerTip";
			String _text = "el Cervecero de Hidromiel de la Plaza del Pueblo, un pequeño edificio para elaborar y servir Hidromiel e Hidromiel Especiada. La Hidromiel se elabora con: Miel y Agua o Miel Silvestre y Agua. La Hidromiel Especiada usa Hidromiel y Hierbas. Emplea 1 cervecero. El Cervecero de Hidromiel puede almacenar un total combinado de 250 de peso. La construcción requiere 55 de trabajo para construirse.";
		}
		{
			String _name = "DSVillageMeadery";
			String _text = "Hidromelería del Pueblo";
		}
