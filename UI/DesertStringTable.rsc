	//STARTING CONDITIONS

		{ String _name = "PalmsOnlyEasyName";		String _text = "Palmeras - Fácil"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Una partida Fácil estándar solo con palmeras. Una partida fácil comienza con seis familias. Se proporciona una gran cantidad de ropa, comida, leña, materiales de construcción y herramientas. Las viviendas y las zonas de almacenamiento ya están construidas. Hay semillas disponibles para campos y huertos, así como un rebaño de ganado."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "Palmeras - Media"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Una partida Media estándar solo con palmeras. Una partida media comienza con cinco familias. Se proporciona ropa, comida, leña, herramientas y materiales de construcción. Ya se ha construido un granero de almacenamiento. Hay disponibles algunas semillas para campos y huertos."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "Palmeras - Difícil"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Una partida Difícil estándar solo con palmeras. Una partida difícil comienza con cuatro familias. Se proporciona una pequeña cantidad de ropa, comida, leña y herramientas. No hay semillas disponibles para el cultivo."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "Palmeras - Adán y Eva"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "Una partida Adán y Eva estándar solo con palmeras. Comienza con solo 2 personas. Se proporciona una pequeña cantidad de comida, leña y ropa en un pequeño carro de almacenamiento. No hay estructuras construidas, y no se dispone inicialmente de semillas ni ganado; tendrás que sobrevivir y conseguirlo todo."; }


