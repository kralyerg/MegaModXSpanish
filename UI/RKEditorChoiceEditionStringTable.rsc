		{ String _name = "NMT30MCrandomQuarryLvl4LWR";		String _text = "cantera aleatoria nivel 4"; }
		{ String _name = "NMT30MCrandomQuarryLvl4Tip";		String _text = "An Random Quarry Lvl4 es un area de trabajo donde puedes mine everything... randomly."; }

