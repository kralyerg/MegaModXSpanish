		{ String _name = "NMT30MCrockQuarryLvl2Tip";		String _text = "An Rock Quarry Lvl2 es un area de trabajo donde puedes mine Stone, Coal or Salt."; }

		{ String _name = "NMT30MCrandomQuarryLvl2";		String _text = "Cantera Aleatoria Nivel 2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2LWR";		String _text = "cantera aleatoria nivel 2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2Tip";		String _text = "An Random Quarry Lvl2 es un area de trabajo donde puedes mine everything... randomly."; }

