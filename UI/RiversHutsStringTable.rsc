		{
			String _name = "ClearWildFood";
			String _text = "Recolectar Comida Silvestre";
		}
		{
			String _name = "ClearWildFoodLwr";
			String _text = "recolectar comida silvestre";
		}
		{
			String _name = "ClearWildFoodTip";
			String _text = "Recolecta y cosecha la comida silvestre que aparece en el área seleccionada. Consejos: La comida silvestre aparece de los árboles y mucha comida nueva aparece de las flores.";
		}
		{
			String _name = "ClearFodder";
			String _text = "Recolectar Forraje";
		}
		{
			String _name = "ClearFodderLwr";
			String _text = "recolectar forraje";
		}
		{
			String _name = "ClearFodderTip";
			String _text = "Recolecta y cosecha parcelas de forraje-paja en el área seleccionada. Consejos: El forraje-paja es el material que obtienes al cosechar parcelas de hierba que puedes ver en el suelo. El forraje se puede usar en los establos, se puede convertir en haces de leña (leña hecha por los leñadores), y se puede usar como material de construcción (apiario, pastizal sin vallas, granero de forraje...). Cada parcela de hierba crea de 4 a 6 forraje-paja (valor 1). Estos se almacenan en un depósito de construcción.";
		}
		{
			String _name = "ClearFlower";
			String _text = "Recolectar Flores";
		}
		{
			String _name = "ClearFlowerLwr";
			String _text = "recolectar flores";
		}
		{
			String _name = "ClearFlowerTip";
			String _text = "Recolecta y cosecha las flores que aparecen en el área seleccionada. Consejos: Las flores tienen la etiqueta de misceláneos. Cada parcela de flores crea de 3 a 5 flores (valor 1). Asegúrate de tener graneros que acepten artículos misceláneos.";
		}
		{
			String _name = "ClearHerb";
			String _text = "Recolectar Hierbas";
		}
		{
			String _name = "ClearHerbLwr";
			String _text = "recolectar hierbas";
		}
		{
			String _name = "ClearHerbTip";
			String _text = "Recolecta y cosecha las hierbas que aparecen en el área seleccionada. Consejos: Las hierbas se usan en un herbolario (o casa de baños) para recuperar 1/2 corazón por uso. Cada parcela de hierbas crea de 2 a 3 hierbas (valor 4). Las hierbas requieren almacenamiento tipo granero.";
		}
		{
			String _name = "ClearCopper";
			String _text = "Recolectar Cobre y Estaño";
		}
		{
			String _name = "ClearCopperLwr";
			String _text = "recolectar cobre";
		}
		{
			String _name = "ClearCopperTip";
			String _text = "Recolecta todo el cobre, estaño y otros minerales raros (oro y plata) en el área seleccionada. Consejos: El cobre se usa para fabricar algunas herramientas y también como material de construcción. El cobre y los demás minerales raros son minerales. Asegúrate de tener un depósito de materiales disponible. Se extraen de 2 a 3 minerales de cobre (valor 4), de 1 a 2 minerales de plata (valor 11) o de 1 a 2 minerales de oro (valor 22). Asegúrate de tener un depósito de minerales disponible para almacenarlos. ";
		}
		{
			String _name = "ClearAlmostAll";
			String _text = "Recolectar Casi Todo";
		}
		{
			String _name = "ClearAlmostAllLwr";
			String _text = "recolectar casi todo";
		}
		{
			String _name = "ClearAlmostAllTip";
			String _text = "Recolecta todos los minerales y piedras en el área seleccionada. Consejos: Esta herramienta especial recolectará todos los minerales y todas las piedras. No eliminará los árboles, la hierba ni otras cosas silvestres valiosas. Muy útil para limpiar rápidamente todas las tierras alrededor de los guardabosques.";
		}
		{
			String _name = "ClearFirewood";
			String _text = "Recolectar Madera Muerta";
		}
		{
			String _name = "ClearFirewoodLwr";
			String _text = "recolectar madera muerta";
		}
		{
			String _name = "ClearFirewoodTip";
			String _text = "Recolecta toda la madera muerta en el área seleccionada para leña. Consejos: La madera muerta son árboles muertos caídos. Cosechar la aparición de madera muerta creará de 5 a 8 leña por árbol muerto.";
		}
		{
			String _name = "ClearIron";
			String _text = "Recolectar Mineral de Hierro";
		}
		{
			String _name = "ClearIronTip";
			String _text = "Recolecta todo el mineral de hierro en el área seleccionada.";
		}
		{
			String _name = "NewMedievalFlatTool";
			String _text = "Herramienta de Nivelación";
		}
		{
			String _name = "NewMedievalFlatToolLwr";
			String _text = "herramienta de nivelación";
		}
		{
			String _name = "NewMedievalFlatToolTip";
			String _text = "La Herramienta de Nivelación sirve para nivelar el terreno de vuelta a la normalidad después de eliminar una pieza de Canal, un Estanque o una Mina a Cielo Abierto... También es muy útil para allanar colinas. Colocará una X naranja en el suelo. Una vez completada la tarea, necesitarás usar la Herramienta de Quitar Edificio para deshacerte de la X naranja.";
		}
	]
}
