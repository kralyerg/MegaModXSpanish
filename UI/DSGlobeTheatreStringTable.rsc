		{ String _name = "DSGlobeTheatre";			String _text = "Teatro Globe"; }
		{ String _name = "DSGlobeTheatreLwr";		String _text = "teatro globe"; }
		{ String _name = "DSGlobeTheatreTip";		String _text = "Inspirado en el Teatro Globe de Shakespeare. Emplea Artistas para trabajar en el teatro, proporcionaran felicidad a los ciudadanos y ganaran una pequeña cantidad de plata. La construcción requiere 610 de trabajo. Solo se puede construir un Teatro Globe por pueblo."; }
		
		
		{ String _name = "EnableWorkDSGlobeTheatre";	String _text = "El teatro esta en funcion"; }
		{ String _name = "EnableWorkDSGlobeTheatreTip";	String _text = "Activa o desactiva el uso de este teatro."; }
		{ String _name = "DisableWorkDSGlobeTheatre";	String _text = "El teatro esta cerrado"; }
		{ String _name = "workPlaceDSGlobeTheatreTxt";	String _text = "En el Teatro Globe, los Artistas entretienen y proporcionan felicidad a los ciudadanos, ganando una pequeña cantidad de Plata."; }
		
		{ String _name = "ProfessionPerformer";				String _text = "Artista"; }
		{ String _name = "ProfessionPerformerTip";			String _text = "Un Artista trabaja en edificios como teatros, contribuyendo a la felicidad de los ciudadanos."; }
