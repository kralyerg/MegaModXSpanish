				{ String _name = "DSSVGathererMenuTip";			String _text = "Recolección de comida forestal de la aldea. Opciones de radio pequeño, mediano y grande. Emplea recolectores para recoger alimentos silvestres (raíces, bayas, champiñones y cebollas)."; }
