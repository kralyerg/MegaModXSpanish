				{ String _name = "DSSVGathererSingleTip";			String _text = "Usa una cesta de recolección para definir un área donde un recolector recoja alimentos silvestres (raíces, bayas, champiñones y cebollas). Requiere 1 cesta de recolección + 1 de trabajo para construir. Radio pequeño (13)."; }
		
