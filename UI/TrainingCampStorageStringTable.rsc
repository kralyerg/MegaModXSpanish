		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Ustedes son los arcos desde los cuales sus hijos son enviados como flechas vivas. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Cada nación tiene una bandera. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "El ataque es el secreto de la defensa; la defensa es la planificación de un ataque. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "No creo que la arquitectura sea solo refugio, solo un simple cerramiento. Deberia poder emocionarte, calmarte, hacerte pensar. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "La raza humana tiene un arma realmente eficaz, y esa es la risa. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "El arma más poderosa de la tierra es el alma humana en llamas. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "La no violencia es un arma poderosa y justa. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Una vida bien ordenada es como subir una torre; la vista a medio camino es mejor que la vista desde la base, y mejora constantemente a medida que el horizonte se expande. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "No puedo mostrarte exactamente como la atención médica es un derecho humano basico. Pero si puedo argumentar que nadie deberia morir de una enfermedad tratable. - Paul Farmer."; }

