		{ String _name = "NMTLittleStorageDockTip";			String _text = "Muelle de Almacenamiento de Muelles NMT (1x1): un area abierta donde se puede almacenar una pequena cantidad de articulos de granero, como comida, ropa y herramientas. Tamaño: 1x1. Costo: 5 troncos. Capacidad: 300 de peso. Consejos, almacena: comida, herramientas, ropa, salud, textiles, artesanía, forjados, telas, preciosos y varios."; }

