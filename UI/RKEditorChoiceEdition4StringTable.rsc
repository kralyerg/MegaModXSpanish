		{ String _name = "NMTBlacksmithDock";			String _text = "Herrería"; }
		{ String _name = "NMTBlacksmithDockLwr";		String _text = "herrería"; }
		{ String _name = "NMTBlacksmithDockTip";		String _text = "Herrería de Muelles NMT: un lugar de trabajo donde se fabrican varias herramientas y se convierten minerales en metales. Tamaño: 7x5. Costo: 65 troncos, 8 piedra, 12 hierro. Emplea 1 herrero. Consejos: fabrica los siguientes tipos de herramientas: de madera (2 troncos), de piedra (1 tronco, 1 piedra), de cobre (1 tronco, 1 cobre), de hierro (1 tronco, 1 hierro), de aleacion de cobre (1 tronco, 1 hierro, 1 cobre), de acero (1 tronco, 1 hierro, 1 carbón) o (1 tronco, 1 hierro, 3 carbón vegetal), de acero al carbono (1 tronco, 2 hierro, 2 carbón) o (1 tronco, 2 hierro, 5 carbón vegetal). Tambien convierte 3 de mineral de hierro en 1 de hierro y 3 de mineral de cobre en 1 de cobre."; }

		{ String _name = "NMTBlacksmith2Dock";			String _text = "Herrería"; }
		{ String _name = "NMTBlacksmith2DockLwr";		String _text = "herrería"; }
		{ String _name = "NMTBlacksmith2DockTip";		String _text = "Herrería de Muelles NMT: un lugar de trabajo donde se fabrican varias herramientas y se convierten minerales en metales. Tamaño: 7x5. Costo: 65 troncos, 8 piedra, 12 hierro. Emplea 1 herrero. Consejos: fabrica los siguientes tipos de herramientas: de madera (2 troncos), de piedra (1 tronco, 1 piedra), de cobre (1 tronco, 1 cobre), de hierro (1 tronco, 1 hierro), de aleacion de cobre (1 tronco, 1 hierro, 1 cobre), de acero (1 tronco, 1 hierro, 1 carbón) o (1 tronco, 1 hierro, 3 carbón vegetal), de acero al carbono (1 tronco, 2 hierro, 2 carbón) o (1 tronco, 2 hierro, 5 carbón vegetal). Tambien convierte 3 de mineral de hierro en 1 de hierro y 3 de mineral de cobre en 1 de cobre."; }

		{ String _name = "NMTBlacksmithStoneDock";		String _text = "Herrería"; }
		{ String _name = "NMTBlacksmithStoneDockLwr";		String _text = "herrería"; }
		{ String _name = "NMTBlacksmithStoneDockTip";		String _text = "Herrería de Muelles de Piedra NMT: un lugar de trabajo donde se fabrican varias herramientas y se convierten minerales en metales. Tamaño: 7x5. Costo: 8 troncos, 65 piedra, 12 hierro. Emplea 1 herrero. Consejos: fabrica los siguientes tipos de herramientas: de madera (2 troncos), de piedra (1 tronco, 1 piedra), de cobre (1 tronco, 1 cobre), de hierro (1 tronco, 1 hierro), de aleacion de cobre (1 tronco, 1 hierro, 1 cobre), de acero (1 tronco, 1 hierro, 1 carbón) o (1 tronco, 1 hierro, 3 carbón vegetal), de acero al carbono (1 tronco, 2 hierro, 2 carbón) o (1 tronco, 2 hierro, 5 carbón vegetal). Tambien convierte 3 de mineral de hierro en 1 de hierro y 3 de mineral de cobre en 1 de cobre."; }

		{ String _name = "NMTWoodcutterDock";			String _text = "Leñador"; }
		{ String _name = "NMTWoodcutterDockLwr";		String _text = "leñador"; }
		{ String _name = "NMTWoodcutterDockTip";		String _text = "Leñador de Muelles NMT: un lugar de trabajo donde se hace leña. Tamaño: 4x5. Costo: 32 troncos. Emplea de 1 a 2 leñadores. Consejos: requiere 2 troncos o 5 de madera o 5 de forraje-paja. Produce de 5 a 8 de leña por trabajo realizado."; }

		{ String _name = "NMTWoodcutterStoneDock";		String _text = "Leñador"; }
		{ String _name = "NMTWoodcutterStoneDockLwr";		String _text = "leñador"; }
		{ String _name = "NMTWoodcutterStoneDockTip";		String _text = "Leñador de Muelles de Piedra NMT: un lugar de trabajo donde se hace leña. Tamaño: 4x5. Costo: 32 piedra. Emplea de 1 a 2 leñadores. Consejos: requiere 2 troncos o 5 de madera o 5 de forraje-paja. Produce de 5 a 8 de leña por trabajo realizado."; }

		{ String _name = "NMTSawmillDock";			String _text = "Aserradero"; }
		{ String _name = "NMTSawmillDockLwr";			String _text = "aserradero"; }
		{ String _name = "NMTSawmillDockTip";			String _text = "Aserradero de Muelles NMT: un lugar de trabajo donde se hace madera o leña a partir de troncos. Tamaño: 7x5. Costo: 48 troncos, 12 hierro. Emplea de 1 a 3 leñadores. Consejos: requiere 1 tronco para madera y 2 para leña. Produce de 3 a 4 de madera o de 5 a 8 de leña por trabajo realizado."; }

		{ String _name = "NMTSawmillStoneDock";			String _text = "Aserradero"; }
		{ String _name = "NMTSawmillStoneDockLwr";		String _text = "aserradero"; }
		{ String _name = "NMTSawmillStoneDockTip";		String _text = "Aserradero de Muelles de Piedra NMT: un lugar de trabajo donde se hace madera o leña a partir de troncos. Tamaño: 7x5. Costo: 48 piedra, 12 hierro. Emplea de 1 a 3 leñadores. Consejos: requiere 1 tronco para madera y 2 para leña. Produce de 3 a 4 de madera o de 5 a 8 de leña por trabajo realizado."; }

		{ String _name = "NMTTailorDock";			String _text = "Sastre"; }
		{ String _name = "NMTTailorDockLwr";			String _text = "sastre"; }
		{ String _name = "NMTTailorDockTip";			String _text = "Sastre de Muelles NMT: un lugar de trabajo donde se fabrican varios tipos de ropa. Tamaño: 7x5. Costo: 54 troncos, 2 hierro. Emplea 1 sastre. Consejos: recursos necesarios: abrigo de cuero (2 cuero o 1 cuero + 1 tela/lino, o 2 tela, o 2 lino), abrigo de lana (2 lana, o 1 lana + 1 tela/lino) o abrigo cálido (2 cuero + 2 lana/tela/lino, o 2 lana + 2 tela/lino, o 2 piel). Los trabajadores educados producen 2 de ropa; los no educados solo 1. Se produciran de 3 a 4 de tela o lino a partir de 12 de algodón o 12 de lino."; }

		{ String _name = "NMTTailorStoneDock";			String _text = "Sastre"; }
		{ String _name = "NMTTailorStoneDockLwr";		String _text = "sastre"; }
		{ String _name = "NMTTailorStoneDockTip";		String _text = "Sastre de Muelles de Piedra NMT: un lugar de trabajo donde se fabrican varios tipos de ropa. Tamaño: 7x5. Costo: 54 piedra, 2 hierro. Emplea 1 sastre. Consejos: recursos necesarios: abrigo de cuero (2 cuero o 1 cuero + 1 tela/lino, o 2 tela, o 2 lino), abrigo de lana (2 lana, o 1 lana + 1 tela/lino) o abrigo cálido (2 cuero + 2 lana/tela/lino, o 2 lana + 2 tela/lino, o 2 piel). Los trabajadores educados producen 2 de ropa; los no educados solo 1. Se produciran de 3 a 4 de tela o lino a partir de 12 de algodón o 12 de lino."; }

		{ String _name = "NMTTavernDock";			String _text = "Taberna"; }
		{ String _name = "NMTTavernDockLwr";			String _text = "taberna"; }
		{ String _name = "NMTTavernDockTip";			String _text = "Taberna de Muelles NMT: un lugar de trabajo donde se hace, almacena y consume cerveza, cerveza tipo ale o vino; aumenta la felicidad de los ciudadanos que viven cerca. Tamaño: 7x7. Costo: 72 troncos, 8 hierro, 12 vidrio. Radio de felicidad (entretenimiento): 30. Emplea de 1 a 3 cerveceros. Consejos: recursos necesarios: cerveza (10 malta), cerveza fuerte (10 malta, 2 lupulo), ale (60 arándanos o 30 manzana, albaricoque, cereza, durazno, pera o calabaza), vino (30 mora, uva, ciruela, frambuesa, morera, fresa, sandia o mango) o hidromiel (45 miel). Produce de 6 a 10 de ale/cerveza/vino."; }

		{ String _name = "NMTTavernStoneDock";			String _text = "Taberna"; }
		{ String _name = "NMTTavernStoneDockLwr";		String _text = "taberna"; }
		{ String _name = "NMTTavernStoneDockTip";		String _text = "Taberna de Muelles de Piedra NMT: un lugar de trabajo donde se hace, almacena y consume cerveza, cerveza tipo ale o vino; aumenta la felicidad de los ciudadanos que viven cerca. Tamaño: 7x7. Costo: 72 piedra, 8 hierro, 12 vidrio. Radio de felicidad (entretenimiento): 36. Emplea de 1 a 3 cerveceros. Consejos: recursos necesarios: cerveza (10 malta), cerveza fuerte (10 malta, 2 lupulo), ale (60 arándanos o 30 manzana, albaricoque, cereza, durazno, pera o calabaza), vino (30 mora, uva, ciruela, frambuesa, morera, fresa, sandia o mango) o hidromiel (45 miel). Produce de 6 a 10 de ale/cerveza/vino."; }

		{ String _name = "NMTDriftersDock";			String _text = "Muelle de Vagabundos"; }
		{ String _name = "NMTDriftersDockLwr";			String _text = "muelle de vagabundos"; }
		{ String _name = "NMTDriftersDockTip";			String _text = "Muelle de Vagabundos NMT: un lugar de trabajo cuya tarea es tomar un bote y buscar troncos de arboles flotantes sin usar. Tamaño: 7x7. Costo: 48 troncos, 8 hierro. Puede producir: de 2 a 3 troncos por trabajo. Emplea de 1 a 3 guardabosques. Consejos: no los veras navegando en sus botes, pero ese es su trabajo de rol: vagar y recoger troncos flotantes. Las cifras de produccion se basan en una casa de guardabosques real."; }

		{ String _name = "NMTDriftersStoneDock";			String _text = "Muelle de Vagabundos"; }
		{ String _name = "NMTDriftersStoneDockLwr";			String _text = "muelle de vagabundos"; }
		{ String _name = "NMTDriftersStoneDockTip";			String _text = "Muelle de Vagabundos de Piedra NMT: un lugar de trabajo cuya tarea es tomar un bote y buscar troncos de arboles flotantes sin usar. Tamaño: 7x7. Costo: 48 troncos, 8 hierro. Puede producir: de 2 a 3 troncos por trabajo realizado. Emplea de 1 a 3 guardabosques. Consejos: no los veras navegando en sus botes, pero ese es su trabajo de rol: vagar y recoger troncos flotantes. Las cifras de produccion se basan en una casa de guardabosques real."; }

		{ String _name = "NMTWaterMineDock";			String _text = "Muelle de Mina Acuática"; }
		{ String _name = "NMTWaterMineDockLwr";			String _text = "muelle de mina acuática"; }
		{ String _name = "NMTWaterMineDockTip";			String _text = "Muelle de Mina Acuática NMT: un lugar de trabajo cuya tarea es tomar aire, sumergirse y minar en el fondo del mar. Tamaño: 10x10. Costo: 92 troncos, 12 hierro. Puede producir aleatoriamente: de 2 a 3 minerales o piedras por trabajo realizado. Emplea de 1 a 8 mineros. Consejos: parte de su trabajo de rol es sumergirse hasta el fondo del mar y minar. Obten preciado mineral de hierro, mineral de cobre, piedra, minerales de plata y oro, y posibilidad de gemas al azar."; }

		//{ String _name = "NMTWaterMineStoneDock";			String _text = "Muelle de Mina Acuática"; }
		//{ String _name = "NMTWaterMineStoneDockLwr";			String _text = "muelle de mina acuática"; }
		//{ String _name = "NMTWaterMineStoneDockTip";			String _text = "Muelle de Mina Acuática de Piedra NMT: un lugar de trabajo cuya tarea es tomar aire, sumergirse y minar en el fondo del mar. Tamaño: 10x10. Costo: 92 piedra, 24 troncos, 12 hierro. Puede producir aleatoriamente: de 2 a 3 minerales o piedras por trabajo realizado. Emplea de 1 a 8 mineros. Consejos: parte de su trabajo de rol es sumergirse hasta el fondo del mar y minar. Obten preciado mineral de hierro, mineral de cobre, piedra, minerales de plata y oro, y posibilidad de gemas al azar."; }


