		{ String _name = "NMTDock1x1GhStorageTip";			String _text = "Almacenamiento Fantasma de Muelles NMT: un area abierta donde se puede almacenar una pequena cantidad de articulos de granero. Tamaño 1x1. Costo: 0. Capacidad: 300 de peso. Consejos: se puede colocar en cualquier lugar, como encima de muelles peatonales; los ciudadanos pueden caminar a través de el. Almacena: comida, herramientas, ropa, salud, textiles, artesanía, forjados, telas, preciosos y varios."; }

		{ String _name = "NMTTradingpostDock";				String _text = "Puesto de Comercio"; }
		{ String _name = "NMTTradingpostDockLwr";			String _text = "puesto de comercio"; }
		{ String _name = "NMTTradingpostDockTip";			String _text = "Puesto de Comercio de Muelles NMT: un lugar de trabajo usado para comprar articulos necesarios a cambio de recursos producidos por el pueblo. Tamaño: 7x9. Costo: 64 madera, 60 troncos, 16 hierro. Radio de felicidad (bienes): 20. Capacidad 60,000 de peso. Emplea de 1 a 8 comerciantes. Consejos: debe construirse en un lago con acceso al río principal para que los mercaderes puedan llegar. El comercio es la única forma de conseguir semillas de cultivo/huerto y ganado."; }

		{ String _name = "NMTTradingpostStoneDock";			String _text = "Puesto de Comercio"; }
		{ String _name = "NMTTradingpostStoneDockLwr";			String _text = "puesto de comercio"; }
		{ String _name = "NMTTradingpostStoneDockTip";			String _text = "Puesto de Comercio de Muelles de Piedra NMT: un lugar de trabajo usado para comprar articulos necesarios a cambio de recursos producidos por el pueblo. Tamaño: 7x9. Costo: 64 madera, 60 piedra, 16 hierro. Radio de felicidad (bienes): 20. Capacidad 66,000 de peso. Emplea de 1 a 8 comerciantes. Consejos: debe construirse en un lago con acceso al río principal para que los mercaderes puedan llegar. El comercio es la única forma de conseguir semillas de cultivo/huerto y ganado."; }

		{ String _name = "NMTMarketDock";				String _text = "Mercado"; }
		{ String _name = "NMTMarketDockLwr";				String _text = "mercado"; }
		{ String _name = "NMTMarketDockTip";				String _text = "Mercado de Muelles NMT: un lugar de trabajo donde los ciudadanos pueden adquirir los bienes que necesitan. Los vendedores obtienen bienes de todo el mapa para mantener el mercado abastecido. Tamaño: 10x10. Costo: 52 madera, 76 troncos. Radio de felicidad (bienes): 45. Capacidad: 12,000 de peso. Emplea de 1 a 8 vendedores. Consejos: abastece comida, ropa, combustible, herramientas y articulos de salud."; }

