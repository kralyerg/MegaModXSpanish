	{ String _name = "DSSVLake";	String _text = "Lago [DSSV]"; }
	{ String _name = "DSSVPlains";	String _text = "Llanura con Lago[DSSV]"; }
	{ String _name = "DSSVPlainsNoLakes";	String _text = "Llanura sin Lago[DSSV]"; }
	{ String _name = "DSSVMountainLakes";	String _text = "Lagos de Montaña [DSSV]"; }
	{ String _name = "DSSVTerrainDesc";	String _text = "[DSSV] = DS Small Village v2 - información de Nuevas Condiciones Iniciales y Nuevos tipos de Terreno:
																	Lago - Un gran lago central, con una pequeña cantidad de tierra utilizable alrededor del borde.
																	Llanura con Lago - Un mapa plano tipo 'Llanura', con un río, y también un lago de tamaño pequeño.
																	Llanura sin lago -- como el anterior - Un mapa de llanura plana, pero esta vez, sin lagos.
																	Lagos de Montaña - Un mapa difícil, casi inhabitable, con grandes cadenas montañosas
																	dominando el paisaje, y lagos profundos tipo 'loch'."; }
	]
}

