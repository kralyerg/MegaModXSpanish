		{ String _name = "MediumName";			String _text = "Media"; }
		{ String _name = "MediumDesc";			String _text = "Una partida media comienza con cinco familias. Se proporciona ropa, 
																comida, leña, herramientas y materiales de construcción. Ya se ha construido
																un granero de almacenamiento.	Hay algunas semillas disponibles para campos y huertos."; }

		{ String _name = "EasyName";			String _text = "Fácil"; }
		{ String _name = "EasyDesc";			String _text = "Una partida fácil comienza con seis familias. Se proporciona una gran cantidad de ropa, 
