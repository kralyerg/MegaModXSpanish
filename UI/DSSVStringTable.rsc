	{ String _name = "DSSVJettyFishmongerLwr";	String _text = "pescadería de embarcadero"; }
	{ String _name = "DSSVJettyFishmongerTip";	String _text = "La Pescadería de Embarcadero clasificará y limpiará el Pescado capturado en el Embarcadero, los Puentes o los Muelles de Pesca. El pescado clasificado puede tener un mayor valor comercial, y ocasionalmente se encuentra un pescado extra, sumándose a la captura total. El recurso Pescado se convertirá en una selección de Lubina, Brema, Carpa, Bacalao, Anguila, Mújol, Perca, Lucio, Salmón, Tenca, Trucha."; }
	{ String _name = "DSSVJettyMolluscFarm";	String _text = "Granja de Moluscos de Embarcadero"; }
	{ String _name = "DSSVJettyMolluscFarmLwr";	String _text = "granja de moluscos de embarcadero"; }
	{ String _name = "DSSVJettyMolluscFarmTip";	String _text = "Una Granja de Moluscos de Embarcadero, emplea hasta 2 pescadores para cultivar y recolectar Mejillones, Almejas y Caracoles. 4x4."; }
	{ String _name = "DSSVJettyPoultryShelter";	String _text = "Refugio de Aves de Embarcadero"; }
