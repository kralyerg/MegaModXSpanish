		{ String _name = "DSSVEasyName";		String _text = "Fácil [DSSV]"; }
		{ String _name = "DSSVEasyDesc";		String _text = "Una partida fácil comienza con seis familias. 2400 de comida, 50 herramientas, 50 de ropa, 400 de leña,
