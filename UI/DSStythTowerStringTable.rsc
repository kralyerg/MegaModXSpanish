StringTable resource
{
	Entry _strings
	[ 
		{ String _name = "DSStythTowerMenuTip";			String _text = "Torres Styth - Torres de vigilancia para tu pueblo. Cuando estan ocupadas, generan una seleccion aleatoria de bienes al confiscar objetos robados de lo que solo podemos suponer que son bandidos... o alienigenas."; }
	
		{ String _name = "DSStythTower";					String _text = "Torre Styth"; }
		{ String _name = "DSStythTowerLwr";					String _text = "torre styth"; }
		{ String _name = "DSStythTowerTip";					String _text = "Torre Styth, la torre de vigilancia Styth original que genera una pequena cantidad aleatoria de objetos para el pueblo (Alcohol, Herramientas, Ropa, Comida, etc.) al liberar la zona de bandidos, el pueblo recibe el botin. Emplea de 1 a 2 Guardias del Pueblo. Solo puedes construir 1 Torre Styth por mapa."; }
		
		{ String _name = "DSNewStythTower";					String _text = "Nueva Torre Styth"; }
		{ String _name = "DSNewStythTowerLwr";				String _text = "nueva torre styth"; }
		{ String _name = "DSNewStythTowerTip";				String _text = "Nueva Torre Styth, una version actualizada de la Torre Styth, ligeramente mas grande, esta torre de vigilancia genera una mejor cantidad de objetos aleatorios para el pueblo (Alcohol, Herramientas, Ropa, Comida, Preciosos, etc.) al liberar la zona de bandidos, el pueblo recibe el botin. Emplea de 2 a 3 Guardias del Pueblo. Solo puedes construir 1 Nueva Torre Styth por mapa."; }
		
		{ String _name = "ProfessionVillageGuard";			String _text = "Guardia del Pueblo"; }
		{ String _name = "ProfessionVillageGuardTip";		String _text = "Un Guardia del Pueblo se emplea para servir y proteger al pueblo. Trabajan en las Torres de Vigilancia. Se acepta que su tasa de mortalidad es mas alta que la de otras profesiones."; }
		{ String _name = "ProfessionVillageGuardDeath";		String _text = "murio de heridas graves, tras proteger al pueblo de los bandidos."; }
		
		
		{ String _name = "Gold";			String _text = "Oro"; }
		{ String _name = "Silver";			String _text = "Plata"; }
		{ String _name = "Gems";			String _text = "Gemas"; }
		
		{ String _name = "Lumber";			String _text = "Madera"; }
