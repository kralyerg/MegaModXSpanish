		{ String _name = "DSSVHerbalist";			String _text = "Herbolario de la aldea"; }
		{ String _name = "DSSVHerbalistLwr";		String _text = "herbolario de la aldea"; }
		{ String _name = "DSSVHerbalistTip";		String _text = "El herbolario de la aldea juega un papel importante en mantener sanos a tus ciudadanos. Recolectarán hierbas y proporcionarán salud y curación simples para los ciudadanos. Emplea de 1 a 2 herbolarios. Requiere 34 de trabajo para construir."; }	
		
		{ String _name = "DSSVHospital";			String _text = "Hospital de la aldea"; }
		{ String _name = "DSSVHospitalLwr";			String _text = "hospital de la aldea"; }
		{ String _name = "DSSVHospitalTip";			String _text = "el hospital de la aldea proporcionará un lugar para que tus ciudadanos enfermos sean atendidos por un médico. Construye esto para obtener el hospital básico; tras la construcción, el hospital se puede mejorar mediante un botón en el panel de información del edificio. Requiere 144 de trabajo."; }
		{ String _name = "HospitalUpgrade1Tip";			String _text = "Mejora el hospital de la aldea, con una capacidad mayor de 45 pacientes, empleando de 1 a 2 médicos con un ala nueva añadida, un muro de piedra exterior y una pequeña mejora de jardín. Requiere 55 de trabajo."; }
				
		
		{ String _name = "DSSVVillageHall";				String _text = "Salón de la aldea"; }
		{ String _name = "DSSVVillageHallLwr";			String _text = "salón de la aldea"; }
		{ String _name = "DSSVVillageHallTip";			String _text = "el salón de la aldea dará felicidad a los ciudadanos, además de registrar y mostrar los datos de la aldea para el jugador. Puedes tener un máximo de 3 salones de aldea en un mapa."; }
		
		{ String _name = "DSSVSchool";					String _text = "Escuela pequeña de la aldea"; }
		{ String _name = "DSSVSchoolLwr";				String _text = "escuela pequeña de la aldea"; }
		{ String _name = "DSSVSchoolTip";				String _text = "Escuela pequeña de la aldea. Proporciona educación para 20 estudiantes, emplea a 1 maestro. Requiere 55 de trabajo para construir."; }
		
		{ String _name = "DSSVChapel";					String _text = "Capilla de la aldea"; }
		{ String _name = "DSSVChapelLwr";				String _text = "capilla de la aldea"; }
		{ String _name = "DSSVChapelTip";				String _text = "Capilla de la aldea. Capacidad de 50 ciudadanos. Requiere 89 de trabajo para construir."; }
		
		{ String _name = "DSSVChurch";					String _text = "Iglesia de la aldea"; }
		{ String _name = "DSSVChurchLwr";				String _text = "iglesia de la aldea"; }
		{ String _name = "DSSVChurchTip";				String _text = "Iglesia de la aldea. Capacidad de 120 ciudadanos. Requiere 144 de trabajo para construir."; }
		
		{ String _name = "DSSVCemeteryMenuTip";		String _text = "Cementerios pequeños de la aldea"; }
		
			{ String _name = "DSSVCemetery";				String _text = "Cementerio de la aldea"; }
			{ String _name = "DSSVCemeteryLwr";				String _text = "cementerio de la aldea"; }
			{ String _name = "DSSVCemeteryTip";				String _text = "Cementerio de la aldea. mín 7x7, máx 30x30. Requiere 1 piedra + 1 trabajo para construir cada casilla. Las lápidas permanecerán en el cementerio de 4 a 6 años."; }
		
			{ String _name = "DSSVCemeterySmall";			String _text = "Cementerio pequeño de la aldea"; }
			{ String _name = "DSSVCemeterySmallLwr";		String _text = "cementerio pequeño de la aldea"; }
			{ String _name = "DSSVCemeterySmallTip";		String _text = "Cementerio pequeño de la aldea. mín 5x5, máx 15x15. Requiere 1 tronco + 1 trabajo para construir cada casilla. Las lápidas permanecerán en el cementerio de 7 a 9 años."; }
			
			{ String _name = "DSSVCemeteryNOF";				String _text = "Cementerio de la aldea sin vallas"; }
			{ String _name = "DSSVCemeteryNOFLwr";			String _text = "cementerio de la aldea sin vallas"; }
